# Para implementacion hay que instalar la extension de "REST Client" de VS Code.

@baseUrl = http://localhost:4000

@apiKey = {{$dotenv BOT_API_KEY}}

# Cliente que ya cargado en la bd, usado como caso real.
@telefono = 5493514330429

// TEST DE AUTENTICACION CON X-API-KEY

### Test de Autenticacion sin X-API-KEY  -  [Espera 401]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}

### Test de Autenticacion con X-API-KEY Incorrecta  -  [Espera 403]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}
x-api-key: esta-key-no-es-la-correcta

### Test de Autenticacion con X-API-KEY Correcta  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}
x-api-key: {{apiKey}}

// TEST DE NORMALIZACION DE TELEFONO

// Primeros tres test con el mismo cliente, escrito en distintos formatos.
// Los tres test tendrian que devolver un 200 y el mismo id del cliente.
// Si se creara un nuevo cliente estaria fallando la normalizacion.

### TEST DE NORMALIZACION DE TELEFONO Formato 549 + 10 dígitos  - [Espera 200]
GET {{baseUrl}}/api/bot/clientes/5493514330429
x-api-key: {{apiKey}}

### TEST DE NORMALIZACION DE TELEFONO Formato sin país ni 9  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/3514330429
x-api-key: {{apiKey}}

### TEST DE NORMALIZACION DE TELEFONO Formato con país pero sin el 9 (así suele llegar el wa_id de WhatsApp en AR)  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/543514330429
x-api-key: {{apiKey}}

### TEST DE NORMALIZACION DE TELEFONO Formato con prefijo nacional 0  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/03514330429
x-api-key: {{apiKey}}

### TEST DE NORMALIZACION DE TELEFONO Formato con el viejo prefijo 15  -  [Espera 400] 
// Se espera un celular argentino con código de área y 
// sin el prefijo 15 (ej: 3514330429 o 5493514330429).
GET {{baseUrl}}/api/bot/clientes/0351154330429
x-api-key: {{apiKey}}


### TEST DE NORMALIZACION DE TELEFONO Formato con letras y números  -  [Espera 400]
GET {{baseUrl}}/api/bot/clientes/abc123
x-api-key: {{apiKey}}


// TEST DE VALIDACION DE NUMERO SIN REGISTRAR


### TEST DE VALIDACION DE NUMERO SIN REGISTRAR - [Espera 404]
// Esta es la rama del n8n para ir al alta: POST /api/bot/visitas/:telefono
// (ver bot-visitas.http). Ya no hay POST /api/bot/clientes: nadie se
// auto-registra, el cliente lo crea el staff al confirmar la visita.
GET {{baseUrl}}/api/bot/clientes/1155667788
x-api-key: {{apiKey}}


// ACTUALIZACION DE CLIENTE (requiere un cliente ya cargado)
### ACTUALIZACION DE CLIENTE Numero invalido - [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/1100000000
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "email": "nadie@example.com"
}


// VALIDACION DEL RATE LIMIT [PARA QUE NO ROMPAN EL BOT A MENSAJES :( ] 

// Para probarlo primero hay que bajar el valor del .env : BOT_RATE_LIMIT_MAX=5 
// Luego de cinco request tendria que devolver un 429 con msj de error.
// VOLVER A DEJAR EL VALOR ORIGINAL DEL .ENV :P

### VALIDACION DEL RATE LIMIT Repetir hasta superar el limite - [Espera 429] 
GET {{baseUrl}}/api/bot/clientes/{{telefono}}
x-api-key: {{apiKey}}

### VALIDACION DEL RATE LIMIT Comprobar que no rompe el resto de los endpoints - [Espera 200]
GET {{baseUrl}}/api/clientes

### VALIDACION DEL RATE LIMIT Comprobar que no rompe el resto de los endpoints - [Espera 200]
GET {{baseUrl}}/api/inmuebles

# Para implementacion hay que instalar la extension de "REST Client" de VS Code.

@baseUrl = http://localhost:4000

@apiKey = {{$dotenv BOT_API_KEY}}

# Cliente que ya esta cargado en la bd, usado como caso real. Tiene inmuebles.
@telefono = 5493514330429

# Segundo cliente (id_cliente 13), sin inmuebles cargados. Sirve para dos cosas:
# la rama "todavia no tiene ninguno" y los test de propiedad.
@telefonoOtroCliente = 1122334455

# Numero que NO es cliente: la rama donde n8n manda a crear el cliente primero.
@telefonoNoCliente = 3519999999

# Un id_inmueble que sea REALMENTE de {{telefono}}. Sacarlo del listado de mas
# abajo: si se pone uno que no es suyo (o que no existe) la respuesta es 404,
# que es el comportamiento correcto, no una falla.
# Postgres genera el id solo (autoincremental), nunca se manda en el body.
@idInmueble = 4

# Completar con el id que devuelve el alta hecha para {{telefonoOtroCliente}}
# (esta mas abajo, en el bloque de propiedad).
@idInmuebleAjeno = 36

# Plaza San Martin, Cordoba. Simula el pin que comparte el cliente por WhatsApp.
@latitud = -31.4201
@longitud = -64.1888


// TEST DE AUTENTICACION CON X-API-KEY

### Test de Autenticacion sin X-API-KEY  -  [Espera 401]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles

### Test de Autenticacion con X-API-KEY Incorrecta  -  [Espera 403]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: esta-key-no-es-la-correcta

### Test de Autenticacion con X-API-KEY Correcta  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}


// TEST DE RESOLUCION DEL CLIENTE POR TELEFONO

// El dueño de los inmuebles sale del telefono de la URL, no del body.
// Los cuatro formatos son el mismo cliente: tienen que devolver la MISMA lista.
// Si alguno devuelve 404 o una lista distinta, esta fallando la normalizacion.

### TEST DE RESOLUCION Formato 549 + 10 digitos  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/5493514330429/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Formato sin pais ni 9  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/3514330429/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Formato con pais pero sin el 9 (asi llega el wa_id)  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/543514330429/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Formato con prefijo nacional 0  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/03514330429/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Formato con el viejo prefijo 15  -  [Espera 400]
GET {{baseUrl}}/api/bot/clientes/0351154330429/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Telefono con letras  -  [Espera 400]
GET {{baseUrl}}/api/bot/clientes/abc123/inmuebles
x-api-key: {{apiKey}}

### TEST DE RESOLUCION Telefono que no es cliente  -  [Espera 404]
// Antes de cargar un inmueble hay que ser cliente: esta seria la rama del n8n
// que manda a crear el cliente primero.
// Ojo al elegir el numero: tiene que ser uno que NO este en la tabla clientes.
GET {{baseUrl}}/api/bot/clientes/{{telefonoNoCliente}}/inmuebles
x-api-key: {{apiKey}}


// TEST DE LISTADO DE INMUEBLES

### TEST DE LISTADO Cliente sin inmuebles cargados  -  [Espera 200 con data vacia]
// NO es un 404: "todavia no tiene ninguno" es la rama del n8n que arranca el
// alta del primer inmueble, no un error. El 404 queda reservado para cuando el
// numero ni siquiera es cliente.
// Correr ANTES del bloque de propiedad, que le carga un inmueble a este numero.
GET {{baseUrl}}/api/bot/clientes/{{telefonoOtroCliente}}/inmuebles
x-api-key: {{apiKey}}

### TEST DE LISTADO Detalle de un inmueble  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}

### TEST DE LISTADO Detalle con id inexistente  -  [Espera 404]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/999999
x-api-key: {{apiKey}}

### TEST DE LISTADO Detalle con id que no es un numero  -  [Espera 400]
// Se corta antes de llegar a Postgres, que devolveria un 22P02 y terminaria en 500.
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/abc
x-api-key: {{apiKey}}


// TEST DE ALTA CON PIN DE WHATSAPP

### TEST DE ALTA Con pin de ubicacion  -  [Espera 201 con origen_coordenadas: "whatsapp"]
// El cliente estaba parado en el inmueble y compartio la ubicacion.
// Las coordenadas se guardan tal cual: NO se consulta Nominatim.
// Verificar en Supabase que latitud/longitud quedaron en -31.4201 / -64.1888.
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "barrio": "Alberdi",
  "superficie_total": 400,
  "superficie_construida": 120,
  "latitud": {{latitud}},
  "longitud": {{longitud}}
}

### TEST DE ALTA Solo con direccion, sin pin  -  [Espera 201 con origen_coordenadas: "nominatim"]
// El cliente no estaba en el domicilio: se geocodifica la direccion.
// Si Nominatim no encuentra nada devuelve 201 igual, con "ninguna".
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Velez Sarsfield 500",
  "tipo_inmueble": "Lote Vacio",
  "provincia": "Cordoba",
  "superficie_total": 250
}

### TEST DE ALTA Sin barrio  -  [Espera 201]
// barrio es nullable: por WhatsApp preguntarlo es un paso mas de conversacion
// y con el pin ya sabemos donde queda.
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Ruta 5 km 12",
  "tipo_inmueble": "Lote Vacio",
  "provincia": "Cordoba",
  "superficie_total": 5000,
  "latitud": {{latitud}},
  "longitud": {{longitud}}
}


// TEST DE VALIDACIONES DEL ALTA

### TEST DE VALIDACION Faltan campos obligatorios  -  [Espera 400]
// Tiene que listar los cuatro que faltan de una, no cortar en el primero:
// si el bot repregunta de a un campo por vez la conversacion es eterna.
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "manzana": "12"
}

### TEST DE VALIDACION Falta superficie_total (NOT NULL)  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba"
}

### TEST DE VALIDACION tipo_inmueble fuera de la lista  -  [Espera 400 listando los permitidos]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles

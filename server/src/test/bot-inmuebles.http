POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 100,
  "superficie_construida": 300
}

### TEST DE VALIDACION superficie_total en cero  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 0
}

### TEST DE VALIDACION superficie que no es un numero  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": "grande"
}

### TEST DE VALIDACION Coordenadas invertidas  -  [Espera 400]
// (-64.18, -31.42) es una coordenada valida pero cae en el Atlantico.
// Es el error tipico de n8n mapeando mal el pin de WhatsApp.
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 400,
  "latitud": -64.1888,
  "longitud": -31.4201
}

### TEST DE VALIDACION Coordenadas de otro pais  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "5th Avenue 100",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 400,
  "latitud": 40.7128,
  "longitud": -74.006
}

### TEST DE VALIDACION Solo latitud, sin longitud  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Colon 1234",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 400,
  "latitud": {{latitud}}
}


// TEST DE PROPIEDAD DEL INMUEBLE

// Lo mas importante de todo el archivo: el dueño sale del telefono, nunca del
// body, y un inmueble ajeno tiene que responder 404 (para este telefono ese
// inmueble no existe) y no 403.

### TEST DE PROPIEDAD Alta con id_cliente ajeno en el body  -  [Espera 201, ignorando el id_cliente]
// Verificar en la respuesta que id_cliente es el del telefono de la URL,
// NO el 999 que mandamos. Si quedo en 999, el body esta pisando al dueño.
POST {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "id_cliente": 999,
  "direccion": "Calle Falsa 123",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 200
}

### TEST DE PROPIEDAD Preparacion: alta de un inmueble para el OTRO cliente  -  [Espera 201]
// Correr este primero y copiar el id_inmueble de la respuesta en la variable
// @idInmuebleAjeno de arriba. Los tres test que siguen usan ese id.
POST {{baseUrl}}/api/bot/clientes/{{telefonoOtroCliente}}/inmuebles
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Bv. San Juan 800",
  "tipo_inmueble": "Casa Habitada",
  "provincia": "Cordoba",
  "superficie_total": 90
}

### TEST DE PROPIEDAD Ver un inmueble de otro cliente  -  [Espera 404]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmuebleAjeno}}
x-api-key: {{apiKey}}

### TEST DE PROPIEDAD Modificar un inmueble de otro cliente  -  [Espera 404, NO modifica nada]
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmuebleAjeno}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Direccion pisada por otro cliente"
}

### TEST DE PROPIEDAD Dar de baja un inmueble de otro cliente  -  [Espera 404, NO da de baja nada]
DELETE {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmuebleAjeno}}/baja
x-api-key: {{apiKey}}


// TEST DE MODIFICACION

### TEST DE MODIFICACION Cambio parcial  -  [Espera 200]
// Lo que no viene no se toca: el resto de los campos queda igual.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "estado_vegetacion": "Alto",
  "altura_cesped_cm": 25
}

### TEST DE MODIFICACION Cambio de direccion  -  [Espera 200 con origen_coordenadas: "nominatim"]
// Al cambiar la direccion se vuelve a geocodificar: las coordenadas viejas
// apuntaban a otro lado. Si Nominatim falla NO se pisan con null.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": "Av. Rafael Nuñez 4500"
}

### TEST DE MODIFICACION Correccion del pin  -  [Espera 200 con origen_coordenadas: "whatsapp"]
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "latitud": -31.3891,
  "longitud": -64.2273
}

### TEST DE MODIFICACION Intento de cambiar el dueño  -  [Espera 200, id_cliente sin cambios]
// id_cliente no esta en la lista blanca de campos editables: se descarta en
// silencio. Verificar en la respuesta que el id_cliente sigue siendo el mismo.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "id_cliente": 999,
  "manzana": "42"
}

### TEST DE MODIFICACION Intento de revivir una baja  -  [Espera 400]
// activo tampoco es editable, asi que el body queda sin ningun campo valido.
// Revivir un inmueble no se puede hacer desde el bot.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "activo": true
}

### TEST DE MODIFICACION Body vacio  -  [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{}

### TEST DE MODIFICACION Vaciar un campo obligatorio  -  [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "direccion": ""
}

### TEST DE MODIFICACION Construida mayor que la total ya guardada  -  [Espera 400]
// Solo viene la construida: la total sale de la fila que ya esta en la bd.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "superficie_construida": 999999
}

### TEST DE MODIFICACION Recalculo de superficie_mantenible  -  [Espera 200]
// Al cambiar las superficies sin mandar la mantenible, se manda null para que
// el trigger de Postgres la recalcule (total - construida).
// Verificar en la respuesta que quedo en 300.
PUT {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "superficie_total": 500,
  "superficie_construida": 200
}


// TEST DE BAJA

### TEST DE BAJA Inmueble propio  -  [Espera 200]
DELETE {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/{{idInmueble}}/baja
x-api-key: {{apiKey}}

### TEST DE BAJA Verificar que ya no aparece en el listado  -  [Espera 200 sin ese id]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}

### TEST DE BAJA Id inexistente  -  [Espera 404]
// Con .single() esto seria un 500 (PGRST116). Por eso se usa maybeSingle.
DELETE {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles/999999/baja
x-api-key: {{apiKey}}


// TEST DE UBICACION INVERSA

// Auxiliar del alta: el cliente manda el pin y el bot le propone la direccion
// para que confirme, en vez de preguntarle calle, barrio y provincia sueltos.
// No escribe nada en la base.

### TEST DE UBICACION INVERSA Pin en Cordoba  -  [Espera 200 con la direccion sugerida]
POST {{baseUrl}}/api/bot/ubicacion/reversa
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "latitud": {{latitud}},
  "longitud": {{longitud}}
}

### TEST DE UBICACION INVERSA Coordenadas invertidas  -  [Espera 400]
POST {{baseUrl}}/api/bot/ubicacion/reversa
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "latitud": -64.1888,
  "longitud": -31.4201
}

### TEST DE UBICACION INVERSA Sin coordenadas  -  [Espera 400]
POST {{baseUrl}}/api/bot/ubicacion/reversa
x-api-key: {{apiKey}}
Content-Type: application/json

{}

### TEST DE UBICACION INVERSA Sin X-API-KEY  -  [Espera 401]
POST {{baseUrl}}/api/bot/ubicacion/reversa
Content-Type: application/json

{
  "latitud": {{latitud}},
  "longitud": {{longitud}}
}


// VALIDACION DEL RATE LIMIT [PARA QUE NO ROMPAN EL BOT A MENSAJES :( ]

// El cupo es GLOBAL del router /api/bot: los endpoints de inmuebles comparten
// el mismo presupuesto que los de clientes, no tienen uno propio.
// Para probarlo primero hay que bajar el valor del .env : BOT_RATE_LIMIT_MAX=5
// Luego de cinco request tendria que devolver un 429 con msj de error.
// VOLVER A DEJAR EL VALOR ORIGINAL DEL .ENV :P

### VALIDACION DEL RATE LIMIT Repetir hasta superar el limite  -  [Espera 429]
GET {{baseUrl}}/api/bot/clientes/{{telefono}}/inmuebles
x-api-key: {{apiKey}}

### VALIDACION DEL RATE LIMIT Comprobar que no rompe el canal web  -  [Espera 401, NO 429]
// El canal web pide JWT, asi que sin token responde 401. Lo que importa acá es
// que NO sea un 429: eso probaria que el cupo del bot se le esta aplicando.
GET {{baseUrl}}/api/inmuebles

# Para implementacion hay que instalar la extension de "REST Client" de VS Code.
#
# ANTES DE CORRER ESTO:
#   1. Ejecutar docs/supabase-verificacion-v2.sql en el SQL Editor de Supabase.
#   2. Completar SMTP_USER/SMTP_PASS en server/.env para que los mails
#      realmente salgan (sin eso, el alta y la recuperacion dan 500 y no queda
#      nada guardado).
#   3. Los codigos hay que leerlos de la casilla del email usado: no hay forma
#      de sacarlos por la API a proposito.

@baseUrl = http://localhost:4000
@apiKey = {{$dotenv BOT_API_KEY}}

@telefonoOriginal = 3513330001
@telefonoNuevo = 3513330002
@emailCliente = test.recuperacion@example.com
@emailNuevo = test.recuperacion.nuevo@example.com


// ALTA POR WHATSAPP - EL CLIENTE SE CREA RECIEN AL CONFIRMAR EL CODIGO

### ALTA Sin email  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "nombre": "Test",
  "apellido": "Recuperacion",
  "telefono": "{{telefonoOriginal}}",
  "tipo_cliente": "Casual"
}

### ALTA Con email  -  [Espera 202, dispara el mail con el codigo]
### Repetirla sirve para reenviar el codigo (el anterior deja de valer).
POST {{baseUrl}}/api/bot/clientes
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "nombre": "Test",
  "apellido": "Recuperacion",
  "telefono": "{{telefonoOriginal}}",
  "tipo_cliente": "Casual",
  "email": "{{emailCliente}}"
}

### ALTA Todavia no es cliente  -  [Espera 404]
GET {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}


// VERIFICACION DEL ALTA (reemplazar 000000 por el codigo recibido)

### VERIFICAR Codigo incorrecto  -  [Espera 400]
POST {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}/verificar-email
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "codigo": "999999"
}

### VERIFICAR Codigo correcto  -  [Espera 201 con email_verificado: true]
POST {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}/verificar-email
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "codigo": "000000"
}

### VERIFICAR Ya es cliente  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}

### ALTA Repetida con el mismo telefono  -  [Espera 409]
POST {{baseUrl}}/api/bot/clientes
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "nombre": "Test",
  "apellido": "Recuperacion",
  "telefono": "{{telefonoOriginal}}",
  "tipo_cliente": "Casual",
  "email": "{{emailCliente}}"
}


// EDICION POR WHATSAPP - SOLO CAMPOS PERMITIDOS

### PUT Cambiar el telefono  -  [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "telefono": "{{telefonoNuevo}}"
}

### PUT Cambiar el email  -  [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "email": "{{emailNuevo}}"
}

### PUT Cambiar el estado  -  [Espera 400]
PUT {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "estado": "activo"
}

### PUT Campos permitidos  -  [Espera 200]
PUT {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "razon_social": "Test SRL"
}


// CAMBIO DE EMAIL CON CODIGO

### CAMBIAR-EMAIL Pedir codigo  -  [Espera 200, mail a la casilla nueva]
POST {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}/cambiar-email
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "emailNuevo": "{{emailNuevo}}"
}

### CAMBIAR-EMAIL Confirmar  -  [Espera 200 con el email nuevo]
POST {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}/confirmar-cambio-email
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "codigo": "000000"
}


// SIMULAR EL CAMBIO DE CELULAR: el numero nuevo todavia no es cliente

### Numero nuevo, todavia no reconocido  -  [Espera 404]
GET {{baseUrl}}/api/bot/clientes/{{telefonoNuevo}}
x-api-key: {{apiKey}}


// RECUPERACION (clientes y staff)

### RECUPERAR Identificador que no existe  -  [Espera 404]
POST {{baseUrl}}/api/bot/recuperar
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "identificador": "no.existe@example.com"
}

### RECUPERAR Con el email  -  [Espera 200 con tipoCuenta: cliente]
POST {{baseUrl}}/api/bot/recuperar
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "identificador": "{{emailNuevo}}"
}

### CONFIRMAR Codigo incorrecto  -  [Espera 400]
POST {{baseUrl}}/api/bot/confirmar-recuperacion
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "identificador": "{{emailNuevo}}",
  "codigo": "999999",
  "telefonoNuevo": "{{telefonoNuevo}}"
}

### CONFIRMAR Codigo correcto  -  [Espera 200]
POST {{baseUrl}}/api/bot/confirmar-recuperacion
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "identificador": "{{emailNuevo}}",
  "codigo": "000000",
  "telefonoNuevo": "{{telefonoNuevo}}"
}

### CONFIRMAR El numero nuevo ya es el cliente  -  [Espera 200]
GET {{baseUrl}}/api/bot/clientes/{{telefonoNuevo}}
x-api-key: {{apiKey}}

### CONFIRMAR El numero viejo ya no es nadie  -  [Espera 404]
GET {{baseUrl}}/api/bot/clientes/{{telefonoOriginal}}
x-api-key: {{apiKey}}

### RECUPERAR Staff con su telefono anterior  -  [Espera 200 con tipoCuenta: usuario]
### Reemplazar por el telefono de un usuario del sistema.
POST {{baseUrl}}/api/bot/recuperar
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "identificador": "3514330429"
}


// LIMPIEZA
// Los clientes de prueba se borran a mano desde Supabase:
//   DELETE FROM public.clientes WHERE email LIKE 'test.%@example.com';

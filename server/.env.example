# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (HOVY API)
# =============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto del servidor (en Azure App Service se inyecta automáticamente)
PORT=4000

# Dominios autorizados para CORS (separados por coma, sin barras finales)
ALLOWED_ORIGINS=http://localhost:5173,https://app.hovyapp.com.ar,https://hovyapp.com.ar

# -----------------------------------------------------------------------------
# SUPABASE (Base de datos PostgreSQL, Auth & Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
# Service Role Key: NUNCA compartir ni exponer en frontend
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# -----------------------------------------------------------------------------
# AUTENTICACIÓN & SEGURIDAD JWT
# -----------------------------------------------------------------------------
JWT_SECRET=tu_secreto_jwt_seguro_y_aleatorio_aqui
JWT_EXPIRES_IN=7d

# Clave secreta para comunicación segura con el Bot de WhatsApp (n8n)
BOT_API_KEY=tu_clave_secreta_para_el_bot_n8n_aqui

# -----------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (SMTP / Nodemailer)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_gmail
EMAIL_FROM="Hovy Mantenimiento" <no-reply@hovyapp.com.ar>

# -----------------------------------------------------------------------------
# INTEGRACIONES EXTERNAS (Opcionales / En desarrollo)
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_token_aqui
GOOGLE_APPLICATION_CREDENTIALS=
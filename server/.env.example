# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (HOVY API)
# =============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto del servidor backend Express
PORT=4000

# Dominios autorizados para CORS (separados por coma, sin barras finales)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,https://hovyapp.com.ar,https://www.hovyapp.com.ar,https://app.hovyapp.com.ar,https://dev.hovyapp.com.ar

# -----------------------------------------------------------------------------
# SUPABASE (Base de datos PostgreSQL, Auth & Storage)
# -----------------------------------------------------------------------------
# Staging: https://kzfziqdmtvrcwotemvyj.supabase.co
# Producción: https://dulaaxavsvgkqqbrvltd.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co
# Service Role Key: NUNCA compartir ni exponer en frontend (acceso administrativo total)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# -----------------------------------------------------------------------------
# AUTENTICACIÓN & SEGURIDAD JWT
# -----------------------------------------------------------------------------
JWT_SECRET=tu_secreto_jwt_seguro_y_aleatorio_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# Clave secreta para comunicación segura con el Bot de WhatsApp (n8n)
BOT_API_KEY=tu_clave_secreta_para_el_bot_n8n_aqui

# -----------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (Zoho Mail SMTP / Nodemailer)
# -----------------------------------------------------------------------------
# Configuración recomendada para Zoho Mail corporativo (contacto@hovyapp.com.ar):
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@hovyapp.com.ar
SMTP_PASS=tu_password_o_app_password_zoho
EMAIL_FROM="Hovy <contacto@hovyapp.com.ar>"

# Alias compatibles con proveedores tradicionales (Gmail, etc.)
# EMAIL_USER=tu_correo@gmail.com
# EMAIL_PASS=tu_app_password

# -----------------------------------------------------------------------------
# INTEGRACIONES EXTERNAS: MERCADO PAGO (OAuth & Cobros Checkout Pro con QR)
# -----------------------------------------------------------------------------
# N.º de la aplicación (Developer Dashboard → tu app)
MERCADOPAGO_APP_ID=
# Client Secret (Developer Dashboard → tu app → Credenciales). Solo servidor.
MERCADOPAGO_CLIENT_SECRET=
# Debe coincidir EXACTO con la Redirect URL cargada en la app de Mercado Pago
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:4000/api/mercadopago/oauth/callback
# A dónde vuelve el usuario después de vincular (pantalla Configuración del front)
MERCADOPAGO_POST_CONNECT_URL=http://localhost:5173/configuracion
# Clave para cifrar los tokens de cada cuenta vinculada (32 bytes en hex)
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# Modo del QR: static | dynamic | hybrid
MERCADOPAGO_QR_MODE=dynamic

# Webhook y pasarela de cobros
# URL pública base del backend accesible para recibir notificaciones IPN/Webhooks de MP
# Localhost: usar ngrok / Staging: https://dev.hovyapp.com.ar / Prod: https://hovyapp.com.ar
MERCADOPAGO_PUBLIC_BASE_URL=https://dev.hovyapp.com.ar
# Secreto para verificar la firma criptográfica x-signature de los webhooks de MP
MERCADOPAGO_WEBHOOK_SECRET=tu_mercadopago_webhook_secret_aqui
# URL de retorno donde redirige Mercado Pago tras completar el pago en Checkout Pro
MERCADOPAGO_PAYMENT_RETURN_URL=https://dev.hovyapp.com.ar/pagos/retorno

# Variables de entorno - SERVER (Hovy)
# Copiar este archivo como .env y completar con los valores del proyecto Supabase

# URL del proyecto Supabase (https://<proyecto>.supabase.co)
SUPABASE_URL=

# Service Role Key de Supabase (SOLO para tareas de administración en el server)
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor
PORT=4000
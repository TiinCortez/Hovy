# Variables de entorno - SERVER (Hovy)
# Copiar este archivo como .env y completar con los valores del proyecto Supabase

# URL del proyecto Supabase (https://<proyecto>.supabase.co)
SUPABASE_URL=

# Service Role Key de Supabase (SOLO para tareas de administración en el server)
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor
PORT=4000

# --- Bot de WhatsApp (n8n) ---

# Clave que el bot manda en el header x-api-key para autenticarse contra
# /api/bot. Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No inventarla a mano: una clave adivinable es lo mismo que no tener clave.
BOT_API_KEY=

# Límite de peticiones del router /api/bot. Es un cupo GLOBAL (no por IP: todo
# el tráfico llega desde n8n). Acota el daño si la API key se filtra y frena un
# flujo de n8n que quede en loop.
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_RATE_LIMIT_MAX=120
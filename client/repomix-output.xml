              onChange={(event) => setSearchTerm(event.target.value)}
              style={{ fontSize: '0.85rem' }}
            />
          </div>
          <span className="badge bg-light text-dark border rounded-pill px-3 py-2 fw-medium text-nowrap">
            Total: <strong>{totalVisible}</strong>
          </span>
        </div>
      </div>

      {/* ÁREA DE CONTENIDO */}

                className="rounded-pill px-4 shadow-sm d-flex align-items-center gap-2" 
                style={{backgroundColor: '#1B3006', borderColor: '#1B3006'}} 
                onClick={() => { onClose(); onEdit(inmuebleData); }}
              >
                <Edit2 size={16} /> Editar Inmueble
              </Button>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  );
}

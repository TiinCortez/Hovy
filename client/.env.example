# Producción: https://api.hovyapp.com.ar/api
VITE_API_URL=http://localhost:4000/api

# Supabase (Auth y cliente público con anon key)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_publica_aqui
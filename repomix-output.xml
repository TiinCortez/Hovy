<file path="client/src/components/visitas/ServiciosVisitaPanel.jsx">
import { useState, useEffect } from 'react';
import { AlertCircle } from 'lucide-react';
import Card from '../ui/Card';
import Button from '../ui/Button';
import ServicioService from '../../services/api/servicio.service';
import VisitaService from '../../services/api/visita.service';
import { getApiError, formatMoney } from './visitaUtils';

// Step 1 of Confirmada: pick services from the admin's active catalog and set m2 per service
export default function ServiciosVisitaPanel({ visita, onSaved }) {
  const defaultM2 = visita.superficie_aproximada != null ? String(visita.superficie_aproximada) : '';
  const saved = Array.isArray(visita.servicios) ? visita.servicios : [];

  const [catalogo, setCatalogo] = useState([]);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState(null);
  // { [id_servicio]: m2 as string } for the selected services
  const [selected, setSelected] = useState(() =>
    Object.fromEntries(saved.map((s) => [s.id_servicio, String(s.superficie_m2)]))
  );
  const [isSaving, setIsSaving] = useState(false);
  const [errorMessage, setErrorMessage] = useState(null);

  useEffect(() => {
    let isMounted = true;
    ServicioService.getMios()
      .then((res) => {
        if (isMounted) setCatalogo((res.data || []).filter((s) => s.activo));
      })
      .catch((err) => {
        if (isMounted) setLoadError(getApiError(err, 'No se pudo cargar tu catálogo de servicios.'));
      })
      .finally(() => {
        if (isMounted) setLoading(false);
      });
    return () => { isMounted = false; };
  }, []);

  const toggle = (id) => {
    setSelected((prev) => {
      const next = { ...prev };
      if (id in next) delete next[id];
      else next[id] = defaultM2;
      return next;
    });
  };

  const setM2 = (id, value) => setSelected((prev) => ({ ...prev, [id]: value }));

  const ids = Object.keys(selected);
  const invalid = ids.some((id) => !(Number(selected[id]) > 0));

  const handleSave = async () => {
    setIsSaving(true);
    setErrorMessage(null);
    try {
      const servicios = ids.map((id) => ({ id_servicio: Number(id), superficie_m2: Number(selected[id]) }));
      await VisitaService.setServicios(visita.id_solicitud, servicios);
      await onSaved('Servicios guardados.');
    } catch (err) {
      setErrorMessage(getApiError(err, 'No se pudieron guardar los servicios.'));
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <Card className="p-4">
      <h5 className="fw-bold text-dark mb-1">1. Servicios y superficie</h5>
      <p className="text-secondary small mb-3">Elegí los servicios de tu catálogo y los m² de cada uno. Al guardar se reemplaza el conjunto anterior.</p>

      {errorMessage && (
        <div className="alert alert-danger d-flex align-items-center gap-2 rounded-3" role="alert">
          <AlertCircle size={18} className="flex-shrink-0" />
          <span className="small fw-medium">{errorMessage}</span>
        </div>
      )}

      {loading ? (
        <div className="text-center py-3"><div className="spinner-border spinner-border-sm" style={{ color: '#1B3006' }} role="status"></div></div>
      ) : loadError ? (
        <p className="text-danger small m-0" role="alert">{loadError}</p>
      ) : catalogo.length === 0 ? (
        <p className="text-secondary small m-0">No tenés servicios activos en tu catálogo. Agregalos desde la sección Servicios.</p>
      ) : (
        <div className="d-flex flex-column gap-2 mb-3">
          {catalogo.map((s) => {
            const checked = s.id_servicio in selected;
            return (
              <div key={s.id_servicio} className="d-flex align-items-center gap-3 p-2 px-3 bg-light rounded-3 border flex-wrap">
                <div className="form-check flex-grow-1 m-0">
                  <input
                    id={`servicio-${s.id_servicio}`}
                    type="checkbox"
                    className="form-check-input"
                    checked={checked}
                    onChange={() => toggle(s.id_servicio)}
                  />
                  <label className="form-check-label small fw-semibold text-dark" htmlFor={`servicio-${s.id_servicio}`}>
                    {s.servicio?.nombre} <span className="text-secondary fw-normal">({formatMoney(s.precio_base)}/m²)</span>
                  </label>
                </div>
                {checked && (
                  <div className="input-group input-group-sm" style={{ maxWidth: '140px' }}>
                    <input
                      type="number"
                      step="any"
                      min="0"
                      className="form-control"
                      aria-label={`m² de ${s.servicio?.nombre}`}
                      value={selected[s.id_servicio]}
                      onChange={(e) => setM2(s.id_servicio, e.target.value)}
                    />
                    <span className="input-group-text">m²</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      <Button
        variant="primary"
        onClick={handleSave}
        disabled={isSaving || loading || ids.length === 0 || invalid}
        style={{ backgroundColor: '#1B3006', borderColor: '#1B3006' }}
      >
        {isSaving ? 'Guardando...' : 'Guardar servicios'}
      </Button>
      {ids.length > 0 && invalid && <p className="text-danger small mt-2 mb-0">Cada servicio necesita m² mayores a 0.</p>}
    </Card>
  );
}
</file>

<file path="client/src/components/visitas/TurnoPanel.jsx">
import { useState } from 'react';
import { AlertCircle } from 'lucide-react';
import Card from '../ui/Card';
import Button from '../ui/Button';
import VisitaService from '../../services/api/visita.service';
import { PRIORIDADES, getApiError, hhmm } from './visitaUtils';

const todayISO = () => {
  const d = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
};

// Step 4 of Confirmada: pick day + slot (or no specific slot) and book the turno.
// `enabled` is false until the final price is accepted (the backend would answer 409).
export default function TurnoPanel({ visita, enabled, onSaved }) {
  const [fecha, setFecha] = useState('');
  const [slots, setSlots] = useState(null); // null = not queried yet
  const [loadingSlots, setLoadingSlots] = useState(false);
  const [slotKey, setSlotKey] = useState(''); // '' = no specific slot
  const [prioridad, setPrioridad] = useState('P3_Casual');
  const [isSaving, setIsSaving] = useState(false);
  const [errorMessage, setErrorMessage] = useState(null);

  const handleFecha = async (value) => {
    setFecha(value);
    setSlotKey('');
    setSlots(null);
    setErrorMessage(null);
    if (!value) return;
    setLoadingSlots(true);
    try {
      const res = await VisitaService.getDisponibilidad(visita.id_solicitud, { fecha: value });
      setSlots(res.data?.[0]?.disponibles || []);
    } catch (err) {
      setErrorMessage(getApiError(err, 'No se pudo consultar la disponibilidad.'));
    } finally {
      setLoadingSlots(false);
    }
  };

  const handleAsignar = async () => {
    setIsSaving(true);
    setErrorMessage(null);
    try {
      const payload = { fecha_programada: fecha, prioridad };
      if (slotKey) {
        const [inicio, hasta] = slotKey.split('|');
        payload.inicio_desde = inicio;
        payload.hasta = hasta;
      }
      await VisitaService.agendarTurno(visita.id_solicitud, payload);
      await onSaved('Turno asignado.');
    } catch (err) {
      setErrorMessage(getApiError(err, 'No se pudo asignar el turno.'));
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <Card className={`p-4 ${enabled ? '' : 'opacity-50'}`}>
      <h5 className="fw-bold text-dark mb-1">4. Turno</h5>
      {!enabled ? (
        <p className="text-secondary small m-0">Disponible cuando el precio final esté aceptado.</p>
      ) : (
        <>
          <p className="text-secondary small mb-3">Elegí el día y, si querés, un horario disponible.</p>

          {errorMessage && (
            <div className="alert alert-danger d-flex align-items-center gap-2 rounded-3" role="alert">
              <AlertCircle size={18} className="flex-shrink-0" />
              <span className="small fw-medium">{errorMessage}</span>
            </div>
          )}

          <div className="row g-3 mb-3">
            <div className="col-12 col-md-6">
              <label className="form-label small fw-bold text-secondary" htmlFor="turno-fecha">Fecha</label>
              <input
                id="turno-fecha"
                type="date"
                min={todayISO()}
                className="form-control bg-light rounded-3"
                value={fecha}
                onChange={(e) => handleFecha(e.target.value)}
              />
            </div>
            <div className="col-12 col-md-6">
              <label className="form-label small fw-bold text-secondary" htmlFor="turno-prioridad">Prioridad</label>
              <select
                id="turno-prioridad"
                className="form-select bg-light rounded-3"
                value={prioridad}
                onChange={(e) => setPrioridad(e.target.value)}
              >
                {PRIORIDADES.map((p) => <option key={p.value} value={p.value}>{p.label}</option>)}
              </select>
            </div>
          </div>

          {fecha && (
            <div className="mb-3">
              <span className="form-label small fw-bold text-secondary d-block mb-2">Horarios disponibles</span>
              {loadingSlots ? (
                <div className="spinner-border spinner-border-sm" style={{ color: '#1B3006' }} role="status"></div>
              ) : slots && (
                <div className="d-flex flex-wrap gap-2">
                  <Button
                    variant={slotKey === '' ? 'primary' : 'light'}
                    className="rounded-pill small"
                    onClick={() => setSlotKey('')}
                  >
                    Sin horario específico
                  </Button>
                  {slots.map((s) => {
                    const key = `${hhmm(s.inicio_desde)}|${hhmm(s.hasta)}`;
                    return (
                      <Button
                        key={key}
                        variant={slotKey === key ? 'primary' : 'light'}
                        className="rounded-pill small"
                        onClick={() => setSlotKey(key)}
                      >
                        {hhmm(s.inicio_desde)} - {hhmm(s.hasta)}
                      </Button>
                    );
                  })}
                  {slots.length === 0 && <span className="text-secondary small align-self-center">No hay horarios libres ese día.</span>}
                </div>
              )}
            </div>
          )}

          <Button
            variant="primary"
            onClick={handleAsignar}
            disabled={isSaving || !fecha}
            style={{ backgroundColor: '#1B3006', borderColor: '#1B3006' }}
          >
            {isSaving ? 'Asignando...' : 'Asignar turno'}
          </Button>
        </>
      )}
    </Card>
  );
}
</file>

<file path="client/src/components/visitas/visitaUtils.js">
// Shared helpers of the visit detail workflow components.

// Allowed values come from the backend (inmuebles.js, clientesController.js, turnosController.js)
export const TIPOS_INMUEBLE = ['Lote Vacio', 'Casa Habitada'];
export const TIPOS_CLIENTE = ['Fijo', 'Casual', 'Empresa'];
export const PRIORIDADES = [
  { value: 'P1_Reasignado', label: 'P1 - Reasignado' },
  { value: 'P2_Fijo', label: 'P2 - Cliente fijo' },
  { value: 'P3_Casual', label: 'P3 - Cliente casual' },
];

export const formatMoney = (value) => `$${Number(value || 0).toLocaleString('es-AR')}`;

export const formatFecha = (valor) => {
  if (!valor) return null;
  return new Date(valor).toLocaleString('es-AR', { dateStyle: 'long', timeStyle: 'short' });
};

// "YYYY-MM-DD" -> readable date without timezone shifts
export const formatDia = (iso) => {
  if (!iso) return null;
  const [y, m, d] = String(iso).slice(0, 10).split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('es-AR', { dateStyle: 'long' });
};

export const hhmm = (hora) => (hora ? String(hora).slice(0, 5) : '');

export const getApiError = (err, fallback) => err.response?.data?.error || fallback;

// Backend "Realizada" means "turno agendado": it is shown as Confirmada
export const getEstadoLabel = (estado) => (estado === 'Realizada' ? 'Confirmada' : estado);

export const BADGE_CLASS = {
  Pendiente: 'bg-warning-subtle text-warning border border-warning-subtle',
  Contactada: 'bg-info-subtle text-info border border-info-subtle',
  Confirmada: 'bg-success-subtle text-success border border-success-subtle',
  Cancelada: 'bg-danger-subtle text-danger border border-danger-subtle',
};

export const INTERNAL_NOTICE = 'Estimado interno - no se comunica al cliente';
</file>


      'x-api-key': 'bot-key-secreta'
    },
    webhook_secret: 'mp-secret'
  });

  assert.equal(limpio.usuario, 'admin');
  assert.equal(limpio.password, '***REDACTED***');
  assert.equal(limpio.headers.Authorization, '***REDACTED***');

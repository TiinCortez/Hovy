import { useEffect, useState } from 'react';
import { AlertCircle, CheckCircle2, MapPin } from 'lucide-react';
import Card from '../ui/Card';
import Button from '../ui/Button';
import Aviso from '../ui/Aviso';
import PerfilService from '../../services/api/perfil.service';
import { getApiError } from '../visitas/visitaUtils';
import { obtenerUbicacion } from './geolocalizacion';
import ConfirmarUbicacionModal from './ConfirmarUbicacionModal';

const VERDE = '#1B3006';

// Optional departure point: the browser gives an approximate position (with the
// user's permission), the user confirms it and from then on the distance of the
// trips to the properties is measured from there.
export default function SalidaCard() {
  const [salida, setSalida] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [loadError, setLoadError] = useState(null);
  const [isBuscando, setIsBuscando] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  const [propuesta, setPropuesta] = useState(null);
  const [error, setError] = useState(null);
  const [errorModal, setErrorModal] = useState(null);
  const [guardado, setGuardado] = useState(false);
  const [confirmandoQuitar, setConfirmandoQuitar] = useState(false);

  useEffect(() => {
    let cancelled = false;
    PerfilService.getSalida()
      .then((res) => { if (!cancelled) setSalida(res.data); })
      .catch((err) => {
        if (!cancelled) setLoadError(getApiError(err, 'No se pudo cargar tu dirección de salida.'));
      })
      .finally(() => { if (!cancelled) setIsLoading(false); });
    return () => { cancelled = true; };
  }, []);

  const handleUsarUbicacion = async () => {
    setError(null);
    setGuardado(false);
    setConfirmandoQuitar(false);
    setIsBuscando(true);
    try {
      const posicion = await obtenerUbicacion();
      const res = await PerfilService.sugerirSalida(posicion);
      setErrorModal(null);
      setPropuesta(res.data);
    } catch (err) {
      setError(err.mensajeUsuario || getApiError(err, 'No se pudo obtener tu ubicación.'));
    } finally {
      setIsBuscando(false);
    }
  };

  const handleConfirmar = async (domicilio) => {
    setIsSaving(true);
    setErrorModal(null);
    try {
      const res = await PerfilService.guardarSalida({
        latitud: propuesta.latitud,
        longitud: propuesta.longitud,
        domicilio: domicilio || null,
      });
      setSalida(res.data);
      setPropuesta(null);
      setGuardado(true);
    } catch (err) {
      setErrorModal(getApiError(err, 'No se pudo guardar la ubicación.'));
    } finally {
      setIsSaving(false);
    }
  };

  const handleQuitar = async () => {
    setError(null);
    setIsSaving(true);
    try {
      const res = await PerfilService.quitarSalida();
      setSalida(res.data);
      setConfirmandoQuitar(false);
      setGuardado(false);
    } catch (err) {
      setError(getApiError(err, 'No se pudo quitar la ubicación.'));
    } finally {
      setIsSaving(false);
    }
  };

  if (isLoading) {
    return <Card title="Dirección de salida"><p className="text-secondary mb-0">Cargando...</p></Card>;
  }

  if (loadError) {
    return <Card title="Dirección de salida"><Aviso tipo="error" icono={AlertCircle}>{loadError}</Aviso></Card>;
  }

  const enlaceMapa = salida?.configurada
    ? `https://www.google.com/maps/search/?api=1&query=${salida.latitud},${salida.longitud}`
    : null;

  return (
    <>
      <Card title="Dirección de salida (opcional)">
        <div className="d-flex flex-column gap-3">
          <p className="text-secondary small mb-0">
            Es el punto desde donde salís hacia tus turnos. Con tu permiso, el navegador obtiene tu ubicación
            aproximada y vos confirmás si querés guardarla. De esto dependen los cálculos de distancia y
            el costo de traslado de los presupuestos.
          </p>

          {error && <Aviso tipo="error" icono={AlertCircle}>{error}</Aviso>}
          {guardado && <Aviso tipo="ok" icono={CheckCircle2}>Dirección de salida guardada.</Aviso>}

          {salida?.configurada ? (
            <div className="d-flex align-items-start gap-2">
              <MapPin size={18} className="flex-shrink-0 mt-1" style={{ color: VERDE }} aria-hidden="true" />
              <div>
                <span className="fw-bold text-dark d-block">{salida.domicilio || 'Ubicación guardada'}</span>
                <span className="text-secondary small">
                  {salida.latitud}, {salida.longitud} ·{' '}
                  <a href={enlaceMapa} target="_blank" rel="noreferrer" style={{ color: VERDE }}>Ver en el mapa</a>
                </span>
              </div>
            </div>
          ) : (
            <div className="combustible-vacio">Todavía no cargaste tu dirección de salida.</div>
          )}

          <div className="d-flex gap-2 flex-wrap align-items-center">
            <Button
              variant="primary"
              onClick={handleUsarUbicacion}
              disabled={isBuscando || isSaving}
              style={{ backgroundColor: VERDE, borderColor: VERDE }}
            >
              {isBuscando
                ? 'Obteniendo ubicación...'
                : (salida?.configurada ? 'Actualizar con mi ubicación' : 'Usar mi ubicación')}
            </Button>

            {salida?.configurada && !confirmandoQuitar && (
              <Button variant="outline-danger" onClick={() => setConfirmandoQuitar(true)} disabled={isBuscando || isSaving}>
                Quitar
              </Button>
            )}
            {salida?.configurada && confirmandoQuitar && (
              <span className="d-flex align-items-center gap-2 small">
                <span className="fw-semibold text-dark">¿Quitar tu dirección de salida?</span>
                <Button variant="danger" size="sm" onClick={handleQuitar} disabled={isSaving}>
                  {isSaving ? 'Quitando...' : 'Sí, quitar'}
                </Button>
                <button type="button" className="btn btn-light btn-sm" onClick={() => setConfirmandoQuitar(false)} disabled={isSaving}>
                  Cancelar
                </button>
              </span>
            )}
          </div>
        </div>
      </Card>

      {propuesta && (
        <ConfirmarUbicacionModal
          // Remounts when a new position is proposed, so the address field restarts.
          key={`${propuesta.latitud},${propuesta.longitud}`}
          propuesta={propuesta}
          isSaving={isSaving}
          error={errorModal}
          onConfirm={handleConfirmar}
          onClose={() => setPropuesta(null)}
        />
      )}
    </>
  );
}
</file>

<file path="client/src/components/turnos/agendaTurnos.js">
// Configuración y cálculos compartidos exclusivamente por el ABMC de Turnos.
// Utilidades puras: no importan configuración ni servicios del servidor.
import { ahoraEnArgentina, sumarDias } from '../../../../server/src/utils/fechaArgentina.js';

export function obtenerAhoraTurnos(ahora = new Date()) {
  return ahoraEnArgentina(ahora);
}

// Las fechas de la agenda son días calendario, sin conversión a UTC.
export const fechaDesdeIso = (iso) => new Date(`${iso}T12:00:00`);

export function fechaAIso(fecha) {
  return `${fecha.getFullYear()}-${String(fecha.getMonth() + 1).padStart(2, '0')}-${String(fecha.getDate()).padStart(2, '0')}`;
}

export function sumarDiasTurnos(iso, cantidad) {
  return sumarDias(iso, cantidad);
}

export function inicioSemanaTurnos(iso) {
  const dia = fechaDesdeIso(iso).getDay();
  return sumarDiasTurnos(iso, -(dia === 0 ? 6 : dia - 1));
}

export function cambiarMesTurnos(iso, cantidad) {
  const fecha = fechaDesdeIso(iso);
  // Evita que el 31 salte al mes siguiente al navegar a un mes más corto.
  fecha.setDate(1);
  fecha.setMonth(fecha.getMonth() + cantidad);
  return fechaAIso(fecha);
}

export function horarioPasadoTurnos(fecha, hora, ahora = obtenerAhoraTurnos()) {
  if (!fecha || !hora) return true;
  const [h, m, s = 0] = hora.split(':').map(Number);
  return fecha < ahora.fecha || (fecha === ahora.fecha && h * 3600 + m * 60 + s < ahora.segundos);
}

export const PRIORIDADES_CONFIG = {
  P1_REASIGNADO: { label: 'P1 Reasignado', short: 'P1 - REASIGNADO', code: 'P1', color: 'danger', weight: 3, description: 'Turno postergado o urgente' },
  P2_FIJO: { label: 'P2 Fijo', short: 'P2 - FIJO', code: 'P2', color: 'success', weight: 2, description: 'Cliente frecuente o abono' },
  P3_CASUAL: { label: 'P3 Casual', short: 'P3 - CASUAL', code: 'P3', color: 'secondary', weight: 1, description: 'Según vacante diaria' }
};

export const PRIORIDADES = Object.entries(PRIORIDADES_CONFIG).map(([value, config]) => ({
  value, title: config.label, description: config.description, color: config.color
}));

const FRANJAS_BASE = [
  { horaInicio: '08:30', horaFin: '11:00' },
  { horaInicio: '11:30', horaFin: '13:30' },
  { horaInicio: '14:00', horaFin: '16:30' },
  { horaInicio: '16:30', horaFin: '18:30' }
];

export function horaAMinutos(hora) {
  if (typeof hora !== 'string' || !/^([01]\d|2[0-3]):[0-5]\d(?::[0-5]\d)?$/.test(hora)) return null;
  const [h, m, s = 0] = hora.split(':').map(Number);
  return h * 60 + m + s / 60;
}

export function minutosAHora(minutos) {
  const total = Math.min(Math.round(minutos), 23 * 60 + 59);
  return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
}

export function tieneHorarioTurno(turno) {
  const inicio = horaAMinutos(turno.franjaHoraria?.horaInicio);
  const fin = horaAMinutos(turno.franjaHoraria?.horaFin);
  return inicio !== null && fin !== null && fin > inicio;
}

export function compararHorarioTurnos(a, b) {
  const inicioA = horaAMinutos(a.franjaHoraria?.horaInicio);
  const inicioB = horaAMinutos(b.franjaHoraria?.horaInicio);
  if (inicioA === null) return inicioB === null ? 0 : 1;
  if (inicioB === null) return -1;
  return inicioA - inicioB;
}

export function formatearHoraCorta(hora) {
  if (typeof hora !== 'string') return '';
  const limpia = hora.trim();
  return /^([01]\d|2[0-3]):[0-5]\d(?::[0-5]\d)?$/.test(limpia) ? limpia.slice(0, 5) : limpia;
}

export function formatearHorarioTurno(turno) {
  return tieneHorarioTurno(turno)
    ? `${formatearHoraCorta(turno.franjaHoraria.horaInicio)} - ${formatearHoraCorta(turno.franjaHoraria.horaFin)} hs`
    : 'Sin horario';
}

export function calcularEstimadoTurno(inmueble, servicioUsuario) {
  if (!inmueble || !servicioUsuario) return null;
  const precioBase = Number(servicioUsuario.precio_base);
  const superficie = Number(inmueble.superficie_mantenible ?? inmueble.superficie_total ?? 0);
  if (!Number.isFinite(precioBase) || precioBase < 0 || !Number.isFinite(superficie) || superficie < 0) return null;
  const superficieEfectiva = superficie > 0 ? superficie : 1;
  const montoEstimado = Math.round(precioBase * superficieEfectiva * 100) / 100;
  return {
    precioBase,
    superficie,
    superficieEfectiva,
    montoEstimado,
  };
}

export function formatearMontoARS(monto) {
  const num = Number(monto);
  if (!Number.isFinite(num)) return '$0';
  return num.toLocaleString('es-AR', {
    style: 'currency',
    currency: 'ARS',
    minimumFractionDigits: num % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  });
}

export function obtenerFranjasTurnos({ fecha, turnos = [], turnoActual, horaInicioInicial }) {
  let slots = FRANJAS_BASE.map((slot) => ({ ...slot }));
  // Conserva la franja exacta de turnos creados fuera de las opciones fijas.
  if (turnoActual && tieneHorarioTurno(turnoActual)) {
    const actual = turnoActual.franjaHoraria;
    slots = slots.filter((slot) => horaAMinutos(slot.horaInicio) !== horaAMinutos(actual.horaInicio));
    slots.push({ horaInicio: actual.horaInicio, horaFin: actual.horaFin });
  }
  const inicioInicial = horaAMinutos(horaInicioInicial);
  if (inicioInicial !== null && !slots.some((slot) => horaAMinutos(slot.horaInicio) === inicioInicial)) {
    slots.push({ horaInicio: horaInicioInicial, horaFin: minutosAHora(inicioInicial + 120) });
  }
  return slots.sort((a, b) => horaAMinutos(a.horaInicio) - horaAMinutos(b.horaInicio)).map((slot) => ({
    ...slot,
    turnoSolapado: turnos.find((turno) => {
      if (turno.estado === 'CANCELADO' || turno.fechaAsignada !== fecha || !tieneHorarioTurno(turno)) return false;
      if (turnoActual && String(turno.idTurno) === String(turnoActual.idTurno)) return false;
      return horaAMinutos(slot.horaInicio) < horaAMinutos(turno.franjaHoraria.horaFin)
        && horaAMinutos(slot.horaFin) > horaAMinutos(turno.franjaHoraria.horaInicio);
    })
  }));
}

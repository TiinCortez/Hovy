export default function MapaAgenda({ turnos, onSelectTurno }) {
  // Filtrar turnos que tengan coordenadas válidas
  const turnosConUbicacion = turnos.filter(t => t.inmueble?.latitud && t.inmueble?.longitud);

  // Centro por defecto (Córdoba Capital)
  const center = [-31.4201, -64.1888];

  return (
    <Card className="p-0 shadow-sm border-0 rounded-4 overflow-hidden d-flex flex-column h-100" style={{ minHeight: '400px' }}>
      {/* El contenedor del mapa toma el 100% del alto y ancho disponible */}

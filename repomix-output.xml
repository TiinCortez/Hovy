<file path="server/src/utils/distancia.js">
// Approximate distance between two points, with no external service.
// Used as a fallback when OpenRouteService is not available.

const RADIO_TIERRA_KM = 6371;

// A road route is longer than the straight line (curves, blocks, detours).
// 1.3 is a rule of thumb for cities, not a measured value for any place.
export const FACTOR_RODEO = 1.3;

const aRadianes = (grados) => (grados * Math.PI) / 180;

// Straight-line distance over the Earth's surface (haversine formula), in km.
export const distanciaLineaRecta = (origen, destino) => {
  const deltaLatitud = aRadianes(destino.latitud - origen.latitud);
  const deltaLongitud = aRadianes(destino.longitud - origen.longitud);

  const a =
    Math.sin(deltaLatitud / 2) ** 2
    + Math.cos(aRadianes(origen.latitud)) * Math.cos(aRadianes(destino.latitud)) * Math.sin(deltaLongitud / 2) ** 2;

  return 2 * RADIO_TIERRA_KM * Math.asin(Math.sqrt(a));
};

// Straight line x detour factor, rounded to 2 decimals.
export const kmAproximados = (origen, destino) =>
  Math.round(distanciaLineaRecta(origen, destino) * FACTOR_RODEO * 100) / 100;
</file>

<file path="server/src/utils/fechaArgentina.js">
// Fechas en huso horario de Argentina, sin depender de dónde corre el server.
//
// En Azure el server corre en UTC: a las 22 hs de Córdoba allá ya es mañana.
// Nace en botVisitasController.js (validar que fecha_preferida no sea
// anterior a hoy) y se comparte acá porque botStaffController.js necesita la
// misma cuenta para recorrer varios días de disponibilidad.

const ZONA_HORARIA = 'America/Argentina/Cordoba';

// en-CA formatea como YYYY-MM-DD, que es lo que se compara como string.
export const hoyEnArgentina = (ahora = new Date()) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: ZONA_HORARIA }).format(ahora);

// Hora argentina para la agenda. No cambia la validación de los consumidores existentes.
export const ahoraEnArgentina = (ahora = new Date()) => {
  const partes = Object.fromEntries(new Intl.DateTimeFormat('en-CA', {
    timeZone: ZONA_HORARIA,
    hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23'
  }).formatToParts(ahora).map(({ type, value }) => [type, value]));
  return {
    fecha: hoyEnArgentina(ahora),
    segundos: Number(partes.hour) * 3600 + Number(partes.minute) * 60 + Number(partes.second)
  };
};

// Suma (o resta, con n negativo) días a una fecha YYYY-MM-DD. Se opera en UTC
// a propósito: como fechaISO no tiene hora, sumar días calendario en UTC no
// se pisa con ningún horario de verano ni con la zona del server.
export const sumarDias = (fechaISO, n) => {
  const [anio, mes, dia] = fechaISO.split('-').map(Number);
  const fecha = new Date(Date.UTC(anio, mes - 1, dia));
  fecha.setUTCDate(fecha.getUTCDate() + n);
  return fecha.toISOString().slice(0, 10);
};

// Fecha de una consulta de solo lectura: sin valor es hoy en Argentina, y con
// valor tiene que ser YYYY-MM-DD y existir. A diferencia de validarFechaNoPasada,
// admite fechas pasadas (consultar un día que ya ocurrió no escribe nada).
// Devuelve { fecha } o { error }.
export const resolverFechaConsulta = (valor, ahora = new Date()) => {
  if (valor === undefined || valor === null || String(valor).trim() === '') {
    return { fecha: hoyEnArgentina(ahora) };
  }

  const fecha = String(valor).trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha)) {
    return { error: 'La fecha tiene que tener el formato YYYY-MM-DD.' };
  }

  const [anio, mes, dia] = fecha.split('-').map(Number);
  const fechaUtc = new Date(Date.UTC(anio, mes - 1, dia));
  if (fechaUtc.getUTCMonth() !== mes - 1 || fechaUtc.getUTCDate() !== dia) {
    return { error: `La fecha no es válida: "${fecha}".` };
  }

  return { fecha };
};

// Devuelve el mensaje de error o null. Chequea el formato y que la fecha
// exista (2026-02-30 pasa la regex pero no es una fecha), y que no sea
// anterior a hoy.
export const validarFechaNoPasada = (fecha, nombreCampo = 'fecha', ahora = new Date()) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha)) {
    return `${nombreCampo} tiene que tener el formato YYYY-MM-DD. Se recibió: "${fecha}"`;
  }

  const [anio, mes, dia] = fecha.split('-').map(Number);
  const fechaUtc = new Date(Date.UTC(anio, mes - 1, dia));
  if (fechaUtc.getUTCMonth() !== mes - 1 || fechaUtc.getUTCDate() !== dia) {
    return `${nombreCampo} no es una fecha válida: "${fecha}"`;
  }

  if (fecha < hoyEnArgentina(ahora)) {
    return `${nombreCampo} no puede ser anterior a hoy.`;
  }

  return null;
};
</file>

<file path="server/src/utils/pagoManual.js">
import { falla } from './solicitudesVisita.js';
import { validarMonto } from '../integrations/mercadopago/cobros/estadoPago.js';

// Pure validation of a payment that is registered by hand (cash or bank transfer).
// Mercado Pago payments do not come through here: they are recorded by the webhook
// or the active check (see aplicarPagoACobro).

export const MEDIOS_MANUALES = ['Efectivo', 'Transferencia'];

// pagos.referencia_comprobante holds up to 100 characters.
const MAX_REFERENCIA = 100;

// Resolves { valores: { medio, monto, referencia } } or { error } (400) joining every
// problem in one message, like the rest of the API. `referencia` is optional: the
// operation number of a transfer, or a note for cash.
export const validarPagoManual = (body) => {
  const errores = [];

  const medioTexto = typeof body?.medio === 'string' ? body.medio.trim().toLowerCase() : '';
  const medio = MEDIOS_MANUALES.find((candidato) => candidato.toLowerCase() === medioTexto);
  if (!medio) errores.push(`El medio de pago tiene que ser uno de: ${MEDIOS_MANUALES.join(', ')}.`);

  const montoCrudo = body?.monto;
  const hayMonto = typeof montoCrudo === 'number' || (typeof montoCrudo === 'string' && montoCrudo.trim() !== '');
  const monto = hayMonto ? validarMonto(Number(montoCrudo)) : null;
  if (monto === null) errores.push('El monto tiene que ser un número mayor a 0 con hasta 2 decimales.');

  let referencia = null;
  const referenciaCruda = body?.referencia;
  if (referenciaCruda !== undefined && referenciaCruda !== null) {
    if (typeof referenciaCruda !== 'string' && typeof referenciaCruda !== 'number') {
      errores.push('La referencia tiene que ser texto.');
    } else {
      const texto = String(referenciaCruda).trim();
      if (texto.length > MAX_REFERENCIA) {
        errores.push(`La referencia puede tener hasta ${MAX_REFERENCIA} caracteres.`);
      } else {
        referencia = texto === '' ? null : texto;
      }
    }
  }

  if (errores.length > 0) return falla(400, errores.join(' '));
  return { valores: { medio, monto, referencia } };
};
</file>

<file path="server/src/utils/rutaDia.js">
import { normalizarCoordenadas } from './coordenadas.js';

// Pure helpers for the day's logistics (route, clients, text for the bot).
// No I/O: the turnos come already loaded.

const hayValor = (valor) => valor !== null && valor !== undefined;

// Turnos of one day -> what the route needs:
//  - turnos / clientes: not cancelled turnos and distinct clients among them.
//  - puntos: property locations in chronological order (turnos without a time go
//    last). A property repeated back to back is one stop; one that comes back
//    later in the day is a new stop.
//  - sin_ubicacion: turnos whose property has no valid location (left out).
//  - sin_horario: turnos without a start time (sorted last, the order is a guess).
export const armarRutaDelDia = (turnos) => {
  const vigentes = Array.isArray(turnos) ? turnos.filter((t) => t && t.estado !== 'Cancelado') : [];

  const clientes = new Set(vigentes.map((t) => t.inmueble?.id_cliente).filter(hayValor));

  const ordenados = [...vigentes].sort((a, b) => {
    const horaA = a.inicio_desde ?? null;
    const horaB = b.inicio_desde ?? null;
    if (horaA === horaB) return 0;
    if (horaA === null) return 1;
    if (horaB === null) return -1;
    return String(horaA).localeCompare(String(horaB));
  });

  const puntos = [];
  let sinUbicacion = 0;
  for (const turno of ordenados) {
    const punto = normalizarCoordenadas(turno.inmueble?.latitud, turno.inmueble?.longitud);
    if (!punto) {
      sinUbicacion += 1;
      continue;
    }
    const ultimo = puntos[puntos.length - 1];
    if (ultimo && ultimo.latitud === punto.latitud && ultimo.longitud === punto.longitud) continue;
    puntos.push(punto);
  }

  return {
    turnos: vigentes.length,
    clientes: clientes.size,
    puntos,
    sin_ubicacion: sinUbicacion,
    sin_horario: vigentes.filter((t) => !t.inicio_desde).length,
  };
};

const numero = (valor) => Number(valor).toLocaleString('es-AR', { maximumFractionDigits: 2 });
const pesos = (valor) => `$${numero(valor)}`;
const plural = (cantidad, singular, pluralTexto) => `${cantidad} ${cantidad === 1 ? singular : pluralTexto}`;
const UNIDAD_TEXTO = { l: 'L', m3: 'm³' };

// Plain-text summary of obtenerLogisticaDia's answer, ready for the WhatsApp bot.
export const armarMensajeLogistica = (datos) => {
  if (!datos || datos.turnos === 0) {
    return `No hay turnos para el ${datos?.fecha ?? 'día consultado'}.`;
  }

  const lineas = [
    `Para el ${datos.fecha} hay ${plural(datos.turnos, 'turno', 'turnos')} con ${plural(datos.clientes_a_visitar, 'cliente', 'clientes')}.`,
  ];

  const { ruta, combustible } = datos;
  if (ruta?.incluido) {
    lineas.push(
      `Ruta estimada: ${numero(ruta.km)} km${ruta.km_aproximados ? ' (aproximado: línea recta con un margen por calles, no una ruta real)' : ''}.`
    );
    if (combustible?.incluido) {
      lineas.push(
        `Consumo estimado: ${numero(combustible.cantidad)} ${UNIDAD_TEXTO[combustible.unidad] ?? ''} de ${combustible.combustible}, unos ${pesos(combustible.costo)}.`
      );
      if (combustible.desactualizado) lineas.push('El precio del combustible podría estar desactualizado.');
    } else if (combustible?.mensaje) {
      lineas.push(`Combustible: ${combustible.mensaje}`);
    }
  } else if (ruta?.mensaje) {
    lineas.push(`No se pudo calcular la ruta: ${ruta.mensaje}`);
  }

  if (datos.sin_ubicacion > 0) {
    lineas.push(`${plural(datos.sin_ubicacion, 'turno sin ubicación quedó', 'turnos sin ubicación quedaron')} fuera de la ruta.`);
  }
  if (datos.sin_horario > 0) {
    lineas.push(`${plural(datos.sin_horario, 'turno sin horario se ubica', 'turnos sin horario se ubican')} al final de la ruta.`);
  }

  return lineas.join(' ');
};
</file>

<file path="server/src/utils/saldoTurno.js">
import { calcularPendienteTrabajo } from '../integrations/mercadopago/cobros/cobroTurno.js';

// Pure: how much a turno costs, how much the client still owes and which payments
// were registered, from data already loaded (no I/O).
//
//  - total: the accepted budget's final value, or null when there is none.
//  - pendiente: what the client still owes. It only exists once the turno is
//    Realizado (that is when the debt is created in the account ledger): the ledger
//    balance of the job, or the budget total when there are no movements. null before.
//  - pagos: the payments of the job (the reference is left out on purpose).
export const armarSaldoTurno = ({ turno, movimientos, presupuesto, pagos }) => {
  const totalNumerico = Number(presupuesto?.monto_total);
  const total = presupuesto?.estado === 'Aceptado' && Number.isFinite(totalNumerico) ? totalNumerico : null;

  const pendiente = turno.estado === 'Realizado'
    ? (calcularPendienteTrabajo(movimientos) ?? total)
    : null;

  return {
    estado: turno.estado,
    cobrado: turno.cobrado === true,
    total,
    pendiente,
    pagos: (Array.isArray(pagos) ? pagos : []).map((pago) => ({
      id_pago: pago.id_pago,
      medio: pago.medio_pago,
      monto: Number(pago.monto),
      estado: pago.estado,
      fecha: pago.fecha_pago ?? null,
    })),
  };
};

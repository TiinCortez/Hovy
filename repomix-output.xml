import React, { useState } from 'react';
import { 
  Users, 
  Building2, 
  CheckCircle2, 
  Clock, 
  Search, 
  SlidersHorizontal, 
  Download, 
  UserPlus, 
  Phone, 
  Mail, 
  Star, 
  ChevronRight, 
  MoreVertical,
  Calendar,
  Home,
  MapPin,
  ChevronDown
} from 'lucide-react';
import Card from '../components/ui/Card';
import Button from '../components/ui/Button';

export default function ClientsPage() {
  const [activeFilter, setActiveFilter] = useState('Todos');
  const [searchTerm, setSearchTerm] = useState('');

  // Datos mock alineados al diseño y la interfaz
  const kpis = [
    { title: 'TOTAL CLIENTES', value: '48', badge: '+4 este mes', badgeType: 'success', icon: Users },
    { title: 'INMUEBLES ACTIVOS', value: '86', detail: 'Fincas gestionadas', icon: Building2 },
    { title: 'CLIENTES AL DÍA', value: '42', badge: '87.5% de cartera', badgeType: 'success', icon: CheckCircle2 },
    { title: 'PAGOS PENDIENTES', value: '6', badge: '$420.000 ARS', badgeType: 'warning', icon: Clock }
  ];

  const clients = [
    {
      id: 1,
      initials: 'JG',
      name: 'Jardines Gómez S.L.',
      subtitle: 'Martín Gómez (Director Op.)',
      type: 'Empresa',
      status: 'Al día',
      rating: '4.9',
      phone: '+34 600 123 456',
      email: 'jardinesgomez.es',
      propertiesCount: '4 inmuebles',
      zone: 'Zona Norte',
      nextService: 'Hoy, 09:00',
      serviceType: 'Mantenimiento integral'
    },
    {
      id: 2,
      initials: 'EA',
      name: 'Estancia Los Álamos',
      subtitle: 'Rodrigo Peñaloza (Administrador)',
      type: 'Agro / Predio',
      status: 'Al día',
      rating: '5.0',
      phone: '+54 9 11 4982-334',
      email: 'adm@losalamos.com',
      propertiesCount: '6 parcelas',
      zone: 'Sector Valle',
      nextService: 'Mañana, 08:30',
      serviceType: 'Riego e inspección'
    },
    {
      id: 3,
      initials: 'MV',
      name: 'María Vallejo',
      subtitle: 'Propietaria Particular',
      type: 'Particular',
      status: 'Pendiente ($65k)',
      rating: '4.7',
      phone: '+54 9 261 540-192',
      email: 'mvallejo@privado.com',
      propertiesCount: '1 residencia',
      zone: 'Colina Alta',
      nextService: 'Jue 18, 14:00',
      serviceType: 'Poda de aromáticas'
    },
    {
      id: 4,
      initials: 'CR',
      name: 'Carlos Ruiz',
      subtitle: 'Desarrollador Inmobiliario',
      type: 'Particular',
      status: 'Al día',
      rating: '4.8',
      phone: '+54 9 261 765-432',
      email: 'cruiz@gruporuiz.com',
      propertiesCount: '2 predios',
      zone: 'El Retiro',
      nextService: 'Mañana, 14:30',
      serviceType: 'Fumigación y abono'
    }
  ];

  const filteredClients = clients.filter(client => {
    const matchesSearch = client.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                          client.subtitle.toLowerCase().includes(searchTerm.toLowerCase());
    if (activeFilter === 'Todos') return matchesSearch;
    if (activeFilter === 'Al día') return matchesSearch && client.status === 'Al día';
    if (activeFilter === 'Pendientes') return matchesSearch && client.status.includes('Pendiente');
    if (activeFilter === 'Empresas') return matchesSearch && client.type === 'Empresa';
    if (activeFilter === 'Particulares') return matchesSearch && client.type === 'Particular';
    return matchesSearch;
  });

  return (
    <div className="d-flex flex-column gap-4 pb-5">
      
      {/* 1. Header de Sección */}
      <div className="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <div>
          <div className="d-flex align-items-center gap-2 mb-1">
            <span className="badge bg-light text-success fw-semibold text-uppercase px-2 py-1" style={{ fontSize: '0.7rem' }}>
              Directorio Operativo
            </span>
            <span className="rounded-circle bg-secondary d-inline-block" style={{ width: '4px', height: '4px' }}></span>
            <span className="text-secondary small fw-medium">Temporada 2026</span>
          </div>
          <h2 className="fw-bold fs-2 text-dark m-0">Clientes</h2>
          <p className="text-secondary small m-0">Directorio general de clientes y gestión integral de inmuebles vinculados.</p>
        </div>

        {/* Acciones del Header */}
        <div className="d-flex align-items-center gap-2 w-100 w-md-auto overflow-x-auto pb-1 pb-md-0">
          <Button variant="outline-primary" className="btn-sm text-nowrap rounded-3 bg-white">
            <Download size={16} /> Exportar (.csv)
          </Button>
          <Button variant="outline-primary" className="btn-sm text-nowrap rounded-3 bg-white">
            <SlidersHorizontal size={16} /> Filtros
          </Button>
          <Button variant="primary" className="btn-sm text-nowrap rounded-3 ms-auto ms-md-0">
            <UserPlus size={16} /> + Nuevo Cliente
          </Button>
        </div>
      </div>

      {/* 2. Tarjetas KPI de Resumen (Responsive Grid / Touch Scroll en móvil) */}
      <div className="row g-3 flex-nowrap flex-md-wrap overflow-x-auto pb-2 pb-md-0 scrollbar-none">
        {kpis.map((kpi, index) => {
          const IconComponent = kpi.icon;
          return (
            <div key={index} className="col-9 col-sm-6 col-xl-3 flex-shrink-0 flex-md-shrink-1">
              <Card className="h-100 p-3 shadow-sm border-0">
                <div className="d-flex align-items-start justify-content-between mb-2">
                  <span className="text-secondary fw-bold text-uppercase" style={{ fontSize: '0.68rem', letterSpacing: '0.05em' }}>
                    {kpi.title}
                  </span>
                  <div className="p-2 rounded-3 bg-light text-success d-flex align-items-center justify-content-center">
                    <IconComponent size={18} />
                  </div>
                </div>
                <div>
                  <h3 className="fw-bold text-dark m-0 fs-3">{kpi.value}</h3>
                  {kpi.badge && (
                    <span className={`badge mt-2 fw-semibold ${kpi.badgeType === 'warning' ? 'bg-warning text-dark' : 'bg-success-subtle text-success'}`}>
                      {kpi.badge}
                    </span>
                  )}
                  {kpi.detail && (
                    <p className="text-secondary small m-0 mt-2">{kpi.detail}</p>
                  )}
                </div>
              </Card>
            </div>
          );
        })}
      </div>

      {/* 3. Filtros y Búsqueda */}
      <Card className="p-2 p-md-3 shadow-sm border-0">
        <div className="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-3">
          
          {/* Buscador */}
          <div className="input-group bg-light rounded-4 px-3 py-1 border-0 flex-grow-1">
            <span className="input-group-text bg-transparent border-0 text-secondary p-0 me-2">
              <Search size={18} />
            </span>
            <input 
              type="text" 
              className="form-control bg-transparent border-0 shadow-none text-dark small"
              placeholder="Buscar por nombre, empresa, teléfono..." 
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
            />
          </div>

          {/* Chips de Selección Rapida */}
          <div className="d-flex align-items-center gap-2 overflow-x-auto pb-1 pb-lg-0 scrollbar-none">
            {['Todos', 'Al día', 'Pendientes', 'Empresas', 'Particulares'].map((filter) => (
              <button
                key={filter}
                onClick={() => setActiveFilter(filter)}
                className={`btn btn-sm rounded-pill text-nowrap px-3 py-1 font-semibold ${
                  activeFilter === filter 
                    ? 'btn-primary' 
                    : 'btn-light text-secondary border'
                }`}
                style={{ fontSize: '0.8rem' }}
              >
                {filter}
              </button>
            ))}
          </div>

        </div>
      </Card>

      {/* 4. Grid de Tarjetas de Clientes */}
      <div className="row g-3">
        {filteredClients.map((client) => (
          <div key={client.id} className="col-12 col-md-6 col-xl-4">
            <Card className="h-100 p-3 shadow-sm border-0 d-flex flex-column justify-between">
              <div>
                {/* Cabecera del Cliente */}
                <div className="d-flex align-items-start justify-content-between gap-2 mb-3">
                  <div className="d-flex align-items-center gap-3">
                    <div 
                      className="rounded-3 d-flex align-items-center justify-content-center fw-bold text-success"
                      style={{ width: '44px', height: '44px', backgroundColor: '#cbecc1' }}
                    >
                      {client.initials}
                    </div>
                    <div>
                      <h5 className="fw-bold text-dark m-0 fs-6">{client.name}</h5>
                      <p className="text-secondary small m-0 text-truncate" style={{ maxWidth: '180px' }}>
                        {client.subtitle}
                      </p>
                    </div>
                  </div>
                  <button className="btn btn-sm btn-link text-secondary p-0">
                    <MoreVertical size={18} />
                  </button>
                </div>

                {/* Badges y Calificación */}
                <div className="d-flex align-items-center gap-2 mb-3 flex-wrap">
                  <span className="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                    {client.type}
                  </span>
                  <span className={`badge rounded-pill px-2 py-1 small ${
                    client.status.includes('Pendiente') 
                      ? 'bg-warning-subtle text-dark border border-warning' 
                      : 'bg-success-subtle text-success'
                  }`}>
                    {client.status}
                  </span>
                  <div className="ms-auto d-flex align-items-center gap-1 text-warning small fw-bold">
                    <Star size={14} fill="#ffc107" />
                    <span className="text-dark">{client.rating}</span>
                  </div>
                </div>

                {/* Contacto Rápido */}
                <div className="p-2 rounded-3 bg-light mb-3 d-flex flex-column gap-1">
                  <div className="d-flex align-items-center gap-2 text-secondary small">
                    <Phone size={14} />
                    <span className="text-dark fw-medium">{client.phone}</span>
                  </div>
                  <div className="d-flex align-items-center gap-2 text-secondary small">
                    <Mail size={14} />
                    <span className="text-dark fw-medium text-truncate">{client.email}</span>
                  </div>
                </div>

                {/* Info Inmuebles y Próximo Turno */}
                <div className="row g-2 mb-3">
                  <div className="col-6">
                    <div className="p-2 rounded-3 bg-light">
                      <span className="text-secondary d-block" style={{ fontSize: '0.7rem' }}>Inmuebles</span>
                      <span className="fw-bold text-dark small d-flex align-items-center gap-1 mt-1">
                        <Home size={14} className="text-success" /> {client.propertiesCount}
                      </span>
                    </div>
                  </div>
                  <div className="col-6">
                    <div className="p-2 rounded-3 bg-light">
                      <span className="text-secondary d-block" style={{ fontSize: '0.7rem' }}>Próximo servicio</span>
                      <span className="fw-bold text-dark small d-flex align-items-center gap-1 mt-1 text-truncate">
                        <Calendar size={14} className="text-success" /> {client.nextService}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Botón Acción hacia Ficha */}
              <button className="btn btn-light w-100 rounded-3 text-success fw-bold small d-flex align-items-center justify-content-center gap-2 py-2 mt-2">
                Ver Inmuebles & Ficha <ChevronRight size={16} />
              </button>
            </Card>
          </div>
        ))}
      </div>

      {/* 5. Footer / Paginación */}
      <div className="d-flex flex-column flex-sm-row align-items-center justify-between gap-3 pt-3 border-top">
        <span className="text-secondary small">
          Mostrando <strong className="text-dark">{filteredClients.length}</strong> de <strong className="text-dark">48</strong> clientes
        </span>
        <button className="btn btn-sm btn-link text-success fw-bold text-decoration-none d-flex align-items-center gap-1">
          Cargar más clientes <ChevronDown size={16} />
        </button>
      </div>

    </div>
  );
}

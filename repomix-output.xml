<file path="server/src/integrations/qr/qrPlantillaService.js">
import fs from 'fs/promises';
import QRCode from 'qrcode';
import sharp from 'sharp';
import { falla } from '../../utils/solicitudesVisita.js';
import {
  RUTA_PLANTILLA,
  PLANTILLA_ANCHO,
  PLANTILLA_ALTO,
  AREA_QR,
  ESCALA_SALIDA,
  MARGEN_MODULOS,
  NIVEL_CORRECCION,
  MAX_LARGO_CONTENIDO,
} from './qrPlantillaConstants.js';

const BLANCO = { r: 255, g: 255, b: 255, alpha: 1 };

// The template (already upscaled) is read once and kept in memory.
let plantillaEnCache = null;

const cargarPlantilla = async () => {
  if (plantillaEnCache) return plantillaEnCache;
  const original = await fs.readFile(RUTA_PLANTILLA);
  const { width, height } = await sharp(original).metadata();
  if (width !== PLANTILLA_ANCHO || height !== PLANTILLA_ALTO) {
    throw new Error(
      `QR template is ${width}x${height}, expected ${PLANTILLA_ANCHO}x${PLANTILLA_ALTO}: update qrPlantillaConstants.js`
    );
  }
  plantillaEnCache = await sharp(original)
    .resize(PLANTILLA_ANCHO * ESCALA_SALIDA, PLANTILLA_ALTO * ESCALA_SALIDA, { kernel: 'lanczos3' })
    .png()
    .toBuffer();
  return plantillaEnCache;
};

// Returns the QR (quiet zone included) as a PNG of exactly the QR area size:
// 1px-per-module PNG -> nearest-neighbour upscale by an integer factor ->
// centered on a white square that also hides the template's placeholder icon.
const generarQrEnArea = async (contenido, ladoArea) => {
  const base = await QRCode.toBuffer(contenido, {
    type: 'png',
    errorCorrectionLevel: NIVEL_CORRECCION,
    margin: MARGEN_MODULOS,
    scale: 1,
  });
  const { width: modulos } = await sharp(base).metadata();
  const pxPorModulo = Math.floor(ladoArea / modulos);
  if (pxPorModulo < 1) return null;

  const lado = modulos * pxPorModulo;
  const sobrante = ladoArea - lado;
  const antes = Math.floor(sobrante / 2);
  return sharp(base)
    .resize(lado, lado, { kernel: 'nearest' })
    .extend({
      top: antes,
      left: antes,
      bottom: sobrante - antes,
      right: sobrante - antes,
      background: BLANCO,
    })
    .png()
    .toBuffer();
};

// Composes `contenido` (e.g. the qr_data of a Mercado Pago order) as a QR on
// the branded template. Resolves to a PNG Buffer or { error: { status, message } }.
export const componerQrEnPlantilla = async (contenido) => {
  if (typeof contenido !== 'string' || contenido.trim() === '') {
    return falla(400, 'El contenido del QR es obligatorio y tiene que ser texto.');
  }
  if (contenido.length > MAX_LARGO_CONTENIDO) {
    return falla(400, `El contenido del QR no puede superar los ${MAX_LARGO_CONTENIDO} caracteres.`);
  }

  const ladoArea = AREA_QR.size * ESCALA_SALIDA;
  let qr;
  try {
    qr = await generarQrEnArea(contenido, ladoArea);
  } catch {
    return falla(422, 'No se pudo generar un código QR con ese contenido.');
  }
  if (!qr) return falla(422, 'El contenido es demasiado largo para entrar en el código QR.');

  const plantilla = await cargarPlantilla();
  return sharp(plantilla)
    .composite([{
      input: qr,
      left: AREA_QR.left * ESCALA_SALIDA,
      top: AREA_QR.top * ESCALA_SALIDA,
    }])
    .png()
    .toBuffer();
};
</file>

<file path="server/src/middleware/apiRateLimit.js">
import { rateLimit } from 'express-rate-limit';

// Límite general de toda la API, aplicado en la raíz (`app.use('/api', ...)`) antes
// de montar las rutas. Es la red de seguridad: cada router puede sumar un límite
// más estricto para sus casos puntuales (QR, OAuth, sugerencias, etc.).
//
// Es generoso a propósito: el panel consulta cada 60 segundos y el cobro con QR
// cada 5, así que un uso normal queda muy por debajo.
//
// Cuenta por IP. Detrás del proxy de staging/producción hace falta
// `app.set('trust proxy', 1)` (ya configurado en app.js), o todos los usuarios
// compartirían el mismo contador.

// Los dos canales que llegan desde servicios y no desde personas ya tienen su
// propio cupo y no se tienen que cortar por un límite general:
//  - /bot: todo el tráfico sale de la misma IP (n8n); tiene su cupo en botRateLimit.
//  - /mercadopago/webhook: Mercado Pago reintenta; un corte perdería pagos.
// `path` es relativo al montaje en /api.
const RUTAS_PROPIAS = /^\/(bot(\/|$)|mercadopago\/webhook(\/|$))/;

export const debeOmitirRateLimit = (path) => RUTAS_PROPIAS.test(path);

export const crearApiRateLimit = ({
  windowMs = Number(process.env.API_RATE_LIMIT_WINDOW_MS) || 60_000,
  limit = Number(process.env.API_RATE_LIMIT_MAX) || 300,
} = {}) =>
  rateLimit({
    windowMs,
    limit,
    standardHeaders: true,
    legacyHeaders: false,
    skip: (req) => debeOmitirRateLimit(req.path),
    // Mantiene el formato { ok, error } del resto de la API.
    handler: (req, res) =>
      res.status(429).json({ ok: false, error: 'Demasiados pedidos. Probá de nuevo en un momento.' }),
  });

export const apiRateLimit = crearApiRateLimit();
</file>

<file path="server/src/middleware/errorHandler.js">
/**
 * errorHandler.js
 * Middleware centralizado de manejo y formateo de errores para Express 5.
 * 
 * Captura excepciones no controladas, mapea códigos de error de Postgres/Supabase
 * (como P0001 de los triggers de cuenta corriente), y emite respuestas JSON limpias
 * correlacionadas con el requestId.
 */

import logger from '../utils/logger.js';

export function errorHandler(err, req, res, next) {
  const requestId = req.id || req.headers['x-request-id'] || 'no-request-id';
  let statusCode = err.status || err.statusCode || 500;
  let clientMessage = err.message || 'Error interno del servidor';

  // Manejo de errores específicos de PostgreSQL / Supabase
  if (err.code === 'P0001') {
    // Triggers de negocio (ej: trg_turno_realizado, trg_turno_cancelado)
    statusCode = 409;
    clientMessage = err.message || 'Conflicto con las reglas de negocio de la base de datos';
  } else if (err.code === '23505') {
    // Violación de restricción UNIQUE
    statusCode = 409;
    clientMessage = 'El registro ya existe en el sistema';
  } else if (err.code === '23503') {
    // Violación de clave foránea
    statusCode = 400;
    clientMessage = 'Referencia a entidad inexistente o inválida';
  } else if (err.name === 'JsonWebTokenError') {
    statusCode = 401;
    clientMessage = 'Token de autenticación inválido';
  } else if (err.name === 'TokenExpiredError') {
    statusCode = 401;
    clientMessage = 'El token de sesión ha expirado';
  } else if (err instanceof SyntaxError && err.status === 400 && 'body' in err) {
    statusCode = 400;
    clientMessage = 'Cuerpo de la petición JSON malformado';
  }

  // Registrar error estructurado en observabilidad
  logger.error(`Error procesando petición HTTP ${req.method} ${req.path}`, {
    requestId,
    statusCode,
    errorCode: err.code || err.name,
    errorMessage: err.message,
    stack: process.env.NODE_ENV !== 'production' ? err.stack : undefined
  });

  res.status(statusCode).json({
    status: 'error',
    statusCode,
    error: clientMessage,
    requestId
  });
}

export default errorHandler;
</file>


                    <span className="d-block text-secondary fw-normal mt-1" style={{fontSize: '0.85rem'}}>
                      {proximoTurno.franjaHoraria.horaInicio.slice(0, 5)} hs
                    </span>
                  )}
                </div>
              ) : (

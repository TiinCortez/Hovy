        <Button onClick={() => navigate('/clients')} variant="outline-primary" className="mt-3 bg-white text-dark border-secondary">
          Volver a Clientes
        </Button>
      </div>
    );
  }

  const nombreMostrar = cliente.razon_social || `${cliente.nombre || ''} ${cliente.apellido || ''}`.trim() || 'Sin Nombre';

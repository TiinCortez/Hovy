<file path="client/src/components/layout/RequireAuth.jsx">
import { useEffect, useState } from 'react';
import { Navigate } from 'react-router-dom';
import httpService from '../../services/api/http.service.js';

export default function RequireAuth({ children }) {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const checkAuth = async () => {
      // 1. Verificamos si existe el token en el navegador
      const token = sessionStorage.getItem('accessToken');

      if (!token) {
        setIsAuthenticated(false);
        setLoading(false);
        return;
      }

      try {
        // 2. Calculamos la URL correcta para validar
        const baseUrl = import.meta.env.VITE_API_URL || 'http://localhost:4000';
        const cleanUrl = baseUrl.replace(/\/api$/, '');

        // 3. Le pegamos al backend para ver si el token sigue vivo
        // Tu httpService ya le inyecta el Bearer Token automáticamente
        await httpService.get(`${cleanUrl}/auth/me`);

        setIsAuthenticated(true);
      } catch {
        // Si el backend devuelve 401 (expirado o inválido), limpiamos y pateamos
        sessionStorage.removeItem('accessToken');
        sessionStorage.removeItem('user');
        setIsAuthenticated(false);
      } finally {
        setLoading(false);
      }
    };

    checkAuth();
  }, []);

  if (loading) {
    return (
      <div className="vh-100 d-flex justify-content-center align-items-center" style={{ backgroundColor: '#F2F2E6' }}>
        <div className="spinner-border" style={{ color: '#1B3006' }} role="status">
          <span className="visually-hidden">Cargando...</span>
        </div>
      </div>
    );
  }

  // Si no pasa la autenticación, redirigimos al Login
  if (!isAuthenticated) {
    return <Navigate to="/login" replace />;
  }

  // Si todo está OK, renderizamos el Dashboard o la vista protegida
  return children;
}
</file>

<file path="client/src/components/mercadopago/DesvincularMercadoPagoModal.jsx">
import { useState } from 'react';
import { createPortal } from 'react-dom';
import { AlertCircle } from 'lucide-react';
import Button from '../ui/Button';
import CloseButton from '../ui/CloseButton';
import MercadoPagoService from '../../services/api/mercadopago.service';

export default function DesvincularMercadoPagoModal({ isOpen, onClose, onUnlinked }) {
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errorMessage, setErrorMessage] = useState(null);

  if (!isOpen) return null;

  const handleConfirm = async () => {
    setIsSubmitting(true);
    setErrorMessage(null);
    try {
      await MercadoPagoService.desvincular();
      await onUnlinked();
      onClose();
    } catch (err) {
      setErrorMessage(err.response?.data?.error || 'No se pudo desvincular la cuenta de Mercado Pago.');
    } finally {
      setIsSubmitting(false);
    }
  };

  return createPortal(
    <div className="modal d-block bg-dark bg-opacity-50" style={{ zIndex: 1060 }}>
      <div className="modal-dialog modal-dialog-centered">
        <div className="modal-content border-0 rounded-4 shadow-lg">
          <div className="modal-header border-bottom-0 pb-0 pt-4 px-4">
            <h5 className="modal-title fw-bold text-dark fs-4">Desvincular Mercado Pago</h5>
            <CloseButton label="Cerrar" onClick={onClose} disabled={isSubmitting} />
          </div>

          <div className="modal-body p-4">
            {errorMessage && (
              <div className="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-3" role="alert">
                <AlertCircle size={18} className="flex-shrink-0" />
                <span className="small fw-medium">{errorMessage}</span>
              </div>
            )}
            <p className="mb-2">¿Seguro que querés desvincular tu cuenta de Mercado Pago?</p>
            <p className="mb-0 small text-secondary">
              Solo se elimina el vínculo en Hovy: no podrás cobrar con QR hasta volver a vincularla,
              y podés hacerlo cuando quieras.
            </p>
          </div>

          <div className="modal-footer border-top-0 pt-0 pb-4 px-4">
            <button type="button" className="btn btn-light rounded-pill px-4 fw-semibold text-secondary" onClick={onClose} disabled={isSubmitting}>
              Cancelar
            </button>
            <Button variant="danger" onClick={handleConfirm} disabled={isSubmitting}>
              {isSubmitting ? 'Desvinculando...' : 'Desvincular'}
            </Button>
          </div>
        </div>
      </div>
    </div>,
    document.body
  );
}
</file>

<file path="client/src/components/mercadopago/MercadoPagoConexionCard.jsx">
import { useCallback, useEffect, useState } from 'react';
import { useSearchParams } from 'react-router-dom';
import { AlertCircle, CheckCircle2 } from 'lucide-react';
import Card from '../ui/Card';
import Button from '../ui/Button';
import MercadoPagoService from '../../services/api/mercadopago.service';
import DesvincularMercadoPagoModal from './DesvincularMercadoPagoModal';
import { alertaDesdeParams } from './mercadopagoMotivos';

const formatFecha = (iso) =>
  iso ? new Date(iso).toLocaleString('es-AR', { dateStyle: 'medium', timeStyle: 'short' }) : '-';

export default function MercadoPagoConexionCard() {
  const [searchParams, setSearchParams] = useSearchParams();
  const [conexion, setConexion] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [loadError, setLoadError] = useState(null);
  const [isLinking, setIsLinking] = useState(false);
  const [linkError, setLinkError] = useState(null);
  const [alerta, setAlerta] = useState(() => alertaDesdeParams(searchParams));
  const [showModal, setShowModal] = useState(false);

  // Reload (retry / after unlink). isLoading starts true, so the first load
  // below only sets state from async callbacks.
  const cargar = useCallback(async () => {
    setIsLoading(true);
    setLoadError(null);
    try {
      const res = await MercadoPagoService.getConexion();
      setConexion(res.data);
    } catch (err) {
      setLoadError(err.response?.data?.error || 'No se pudo consultar el estado de Mercado Pago.');
    } finally {
      setIsLoading(false);
    }
  }, []);

  useEffect(() => {
    let cancelled = false;
    MercadoPagoService.getConexion()
      .then((res) => { if (!cancelled) setConexion(res.data); })
      .catch((err) => {
        if (!cancelled) setLoadError(err.response?.data?.error || 'No se pudo consultar el estado de Mercado Pago.');
      })
      .finally(() => { if (!cancelled) setIsLoading(false); });
    return () => { cancelled = true; };
  }, []);

  // Remove the return params so a refresh does not repeat the alert.
  useEffect(() => {
    if (searchParams.has('mercadopago') || searchParams.has('motivo')) {
      const next = new URLSearchParams(searchParams);
      next.delete('mercadopago');
      next.delete('motivo');
      setSearchParams(next, { replace: true });
    }
  }, [searchParams, setSearchParams]);

  const handleVincular = async () => {
    setIsLinking(true);
    setLinkError(null);
    setAlerta(null);
    try {
      const res = await MercadoPagoService.iniciarVinculacion();
      const url = res?.data?.url;
      if (typeof url !== 'string' || !url.startsWith('https://')) {
        throw new Error('invalid-url');
      }
      window.location.assign(url);
    } catch (err) {
      setLinkError(err.response?.data?.error || 'No se pudo iniciar la vinculación con Mercado Pago.');
      setIsLinking(false);
    }
  };

  const reautorizar = conexion?.estado === 'Reautorizar';
  const conectada = conexion?.conectada === true;
  const vinculada = conectada || reautorizar;

  return (
    <Card title="Mercado Pago">
      <div className="d-flex flex-column gap-3">
        {alerta && (
          <div className={`alert alert-${alerta.type} alert-dismissible d-flex align-items-center gap-2 rounded-3 mb-0`} role="alert">
            {alerta.type === 'success' ? <CheckCircle2 size={18} className="flex-shrink-0" /> : <AlertCircle size={18} className="flex-shrink-0" />}
            <span className="small fw-medium">{alerta.message}</span>
            <button type="button" className="btn-close" aria-label="Cerrar" onClick={() => setAlerta(null)} />
          </div>
        )}

        {linkError && (
          <div className="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-0" role="alert">
            <AlertCircle size={18} className="flex-shrink-0" />
            <span className="small fw-medium">{linkError}</span>
          </div>
        )}

        {isLoading && <p className="text-secondary mb-0">Cargando estado de la conexión...</p>}

        {!isLoading && loadError && (
          <div className="d-flex align-items-center gap-3 flex-wrap">
            <span className="text-danger small fw-medium">{loadError}</span>
            <Button variant="light" size="sm" className="rounded-pill" onClick={cargar}>Reintentar</Button>
          </div>
        )}

        {!isLoading && !loadError && conexion && (
          <>
            {conectada && (
              <div>
                <span className="badge text-bg-success rounded-pill mb-2">Conectada</span>
                <p className="mb-1">Cuenta de Mercado Pago vinculada (ID {conexion.mp_user_id}).</p>
                <p className="small text-secondary mb-0">Autorización vigente hasta {formatFecha(conexion.expira_en)}. Se renueva automáticamente.</p>
              </div>
            )}
            {reautorizar && (
              <div>
                <span className="badge text-bg-warning rounded-pill mb-2">Reautorizar</span>
                <p className="mb-0">La vinculación con Mercado Pago venció o fue revocada. Volvé a vincular tu cuenta para seguir cobrando.</p>
              </div>
            )}
            {!vinculada && (
              <p className="mb-0 text-secondary">Todavía no vinculaste tu cuenta de Mercado Pago. Vinculala para cobrar a tus clientes con QR.</p>
            )}

            <div className="d-flex gap-2 flex-wrap">
              <Button onClick={handleVincular} disabled={isLinking}>
                {isLinking ? 'Redirigiendo...' : (reautorizar ? 'Volver a vincular' : 'Vincular Mercado Pago')}
              </Button>
              {vinculada && (
                <Button variant="outline-danger" onClick={() => setShowModal(true)} disabled={isLinking}>
                  Desvincular
                </Button>
              )}
            </div>
          </>
        )}
      </div>

      <DesvincularMercadoPagoModal
        isOpen={showModal}
        onClose={() => setShowModal(false)}
        onUnlinked={cargar}
      />
    </Card>
  );
}
</file>

<file path="client/src/components/mercadopago/mercadopagoMotivos.js">
// Maps the short `motivo` codes sent by the backend callback redirect to Spanish messages.
const MOTIVOS = {
  autorizacion_rechazada: 'Cancelaste o rechazaste la autorización en Mercado Pago.',
  parametros_invalidos: 'La respuesta de Mercado Pago no es válida. Intentá vincular de nuevo.',
  configuracion: 'La integración con Mercado Pago no está configurada en el servidor.',
  state_invalido: 'El enlace de vinculación venció o ya fue usado. Iniciá la vinculación de nuevo.',
  intercambio_fallido: 'Mercado Pago no pudo confirmar la autorización. Intentá de nuevo.',
  interno: 'Ocurrió un error interno al guardar la vinculación. Intentá de nuevo.',
};

const GENERICO = 'No se pudo vincular Mercado Pago. Intentá de nuevo.';

export const mensajeMotivo = (motivo) =>
  (typeof motivo === 'string' && Object.hasOwn(MOTIVOS, motivo)) ? MOTIVOS[motivo] : GENERICO;

// Builds a { type, message } alert from the ?mercadopago= query params, or null.
export const alertaDesdeParams = (params) => {
  const resultado = params.get('mercadopago');
  if (resultado === 'conectado') {
    return { type: 'success', message: 'Tu cuenta de Mercado Pago quedó vinculada.' };
  }
  if (resultado === 'error') {
    return { type: 'danger', message: mensajeMotivo(params.get('motivo')) };
  }
  return null;
};

<file path="docs/migrations/002_codigos_verificacion_v2.sql">
-- Verificación v2: el alta de clientes por WhatsApp ya no inserta en
-- `clientes` hasta que se confirma el código. Mientras tanto, el alta vive en
-- codigos_verificacion: sin cliente_id y con los datos a insertar en `datos`.
--
-- Correr una vez en el SQL Editor de Supabase, y DESPUÉS
-- supabase-password-temporal.sql, que deja las restricciones finales de la
-- tabla (los CHECK de tipo y de entidad se definen allá).

ALTER TABLE public.codigos_verificacion
  ADD COLUMN IF NOT EXISTS email TEXT,
  ADD COLUMN IF NOT EXISTS telefono TEXT,
  ADD COLUMN IF NOT EXISTS datos JSONB;

-- Quita el CHECK original "exactamente uno de usuario_id/cliente_id", que no
-- admite altas pendientes. Como no sabemos con qué nombre se creó, se borran
-- todos los CHECK de la tabla que mencionen usuario_id o cliente_id, y también
-- el de la lista de tipos: supabase-password-temporal.sql crea los dos nuevos.
DO $$
DECLARE
  restriccion RECORD;
BEGIN
  FOR restriccion IN
    SELECT conname
    FROM pg_constraint
    WHERE conrelid = 'public.codigos_verificacion'::regclass
      AND contype = 'c'
      AND (pg_get_constraintdef(oid) ILIKE '%usuario_id%' OR pg_get_constraintdef(oid) ILIKE '%cliente_id%')
  LOOP
    EXECUTE format('ALTER TABLE public.codigos_verificacion DROP CONSTRAINT %I', restriccion.conname);
  END LOOP;
END $$;

ALTER TABLE public.codigos_verificacion DROP CONSTRAINT IF EXISTS codigos_verificacion_tipo_check;

CREATE INDEX IF NOT EXISTS codigos_alta_idx
  ON public.codigos_verificacion (tipo, email, telefono);
</file>

<file path="docs/migrations/003_password_temporal_y_estados.sql">
-- Alta de staff con contraseña temporal. Correr una vez en el SQL Editor de
-- Supabase, DESPUÉS de supabase-verificacion-v2.sql. Este archivo deja el
-- estado final de codigos_verificacion.
--
-- El staff lo carga un admin desde la web: el usuario se crea en el momento
-- con una contraseña temporal (enviada por email) que tiene que cambiar en el
-- primer login. Reemplaza al alta de staff con código, que se elimina.

ALTER TABLE public.usuarios
  ADD COLUMN IF NOT EXISTS debe_cambiar_password BOOLEAN NOT NULL DEFAULT false,
  ADD COLUMN IF NOT EXISTS password_temporal_expira TIMESTAMPTZ;

-- Códigos que ya no genera ningún flujo: el alta de staff con código
-- (alta_usuario, verificacion_email) y la verificación vieja de clientes
-- (verificacion_email_cliente).
DELETE FROM public.codigos_verificacion
WHERE tipo IN ('alta_usuario', 'verificacion_email', 'verificacion_email_cliente');

ALTER TABLE public.codigos_verificacion DROP CONSTRAINT IF EXISTS codigos_verificacion_tipo_check;
ALTER TABLE public.codigos_verificacion ADD CONSTRAINT codigos_verificacion_tipo_check CHECK (
  tipo IN (
    'alta_cliente',
    'cambio_email_cliente',
    'recuperacion_password',
    'recuperacion_telefono_cliente',
    'recuperacion_telefono_usuario'
  )
);

-- Solo el alta de cliente vive sin cuenta asociada (los datos van en `datos`
-- hasta confirmar el código); el resto es sobre un cliente o usuario que existe.
ALTER TABLE public.codigos_verificacion DROP CONSTRAINT IF EXISTS codigos_entidad_chk;
ALTER TABLE public.codigos_verificacion ADD CONSTRAINT codigos_entidad_chk CHECK (
  (tipo = 'alta_cliente' AND usuario_id IS NULL AND cliente_id IS NULL AND datos IS NOT NULL)
  OR
  (tipo <> 'alta_cliente' AND num_nonnulls(usuario_id, cliente_id) = 1)
);
</file>

<file path="docs/migrations/004_servicios_catalogo.sql">
-- Per-user service catalog.
--
-- Run once in the Supabase SQL Editor. It is idempotent where possible.
--
-- Design:
--   servicios_catalogo  -> global list of service TYPES (name, description,
--                          quotation variable). No prices here.
--   usuario_servicio    -> bridge: each user offers a subset of the types with
--                          their own precio_base / limite_operativo / activo.

-- 1) Global catalog: remove per-user columns -------------------------------
-- WARNING: this DROPS data. precio_base, limite_operativo and activo are being
-- moved to usuario_servicio. Confirm that servicios_catalogo has no data worth
-- keeping before running this block (the table was unused by application code).
ALTER TABLE public.servicios_catalogo
  DROP COLUMN IF EXISTS precio_base,
  DROP COLUMN IF EXISTS limite_operativo,
  DROP COLUMN IF EXISTS activo;

-- Unique service name (needed for the idempotent seed below).
-- If the table already holds duplicated names this will fail: clean them first.
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_constraint
    WHERE conrelid = 'public.servicios_catalogo'::regclass
      AND conname = 'servicios_catalogo_nombre_key'
  ) THEN
    ALTER TABLE public.servicios_catalogo
      ADD CONSTRAINT servicios_catalogo_nombre_key UNIQUE (nombre);
  END IF;
END $$;

-- 2) Bridge table -----------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.usuario_servicio (
  id_usuario_servicio BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_usuario          BIGINT NOT NULL REFERENCES public.usuarios (id),
  id_servicio         BIGINT NOT NULL REFERENCES public.servicios_catalogo (id_servicio),
  precio_base         NUMERIC(12, 2) NOT NULL CHECK (precio_base >= 0),
  limite_operativo    NUMERIC,
  activo              BOOLEAN NOT NULL DEFAULT TRUE,
  UNIQUE (id_usuario, id_servicio)
);
-- NOTE: if servicios_catalogo.id_servicio is not BIGINT (e.g. INTEGER), adjust
-- the id_servicio column type above so the foreign key can be created.
-- limite_operativo has no unit defined yet (placeholder: plain numeric).

CREATE INDEX IF NOT EXISTS usuario_servicio_usuario_idx
  ON public.usuario_servicio (id_usuario);

-- 3) Optional seed (disabled) -----------------------------------------------
-- Services are now created by users (POST /api/servicios/catalogo finds or
-- creates the type by name), so seeding the 6 original types is OPTIONAL.
-- Uncomment only if you want them pre-loaded. Values are PLACEHOLDERS.

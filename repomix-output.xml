  color: $metricas-texto-tenue;
  transform: translateY(-50%);
  pointer-events: none;
}

.metricas-leyenda {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 1.25rem;
  padding: 0.5rem 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: $metricas-texto;
  background-color: $metricas-superficie;
  border-radius: 0.75rem;

  > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
}

.metricas-leyenda-color {
  display: inline-block;
  width: 14px;
  height: 14px;
  border-radius: 4px;

  &--cobrado { background-color: $metricas-verde; }
  &--pendiente { background-color: $metricas-barra-pendiente; }
  &--traslado { background-color: $metricas-barra-traslado; }
}

/* --- Gráfico de barras --- */
.metricas-grafico-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 0.25rem;
}

// Columna 1: eje Y. Columna 2: área de barras. Fila 2: meses debajo del eje $0.
// Líneas, etiquetas y barras usan la misma base (bottom: 0), así la barra
// arranca exactamente sobre la línea de $0.
.metricas-grafico {
  display: grid;
  grid-template-columns: 6rem minmax(0, 1fr);
  grid-template-rows: $metricas-alto-grafico auto;
  padding-top: 0.75rem;
}

.metricas-grafico-eje {
  position: relative;
  grid-column: 1;
  grid-row: 1;

  > span {
    position: absolute;
    right: 0.75rem;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    color: $metricas-texto-tenue;
    white-space: nowrap;
    transform: translateY(50%);
    font-variant-numeric: tabular-nums;
  }
}

.metricas-grafico-area {
  position: relative;
  grid-column: 2;
  grid-row: 1;
}

.metricas-grafico-linea {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background-color: rgba(234, 232, 229, 0.8);
  pointer-events: none;

  &.is-base { background-color: #E4E2DF; }
}

.metricas-grafico-columnas {
  position: absolute;
  inset: 0;
  display: flex;
}

.metricas-grafico-columna {
  position: relative;
  flex: 1 1 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
  border-radius: 0.5rem 0.5rem 0 0;
  cursor: pointer;
  transition: background-color 0.15s ease;

  &.is-activa,
  &.is-destacada { background-color: rgba(203, 236, 193, 0.18); }

  &:focus-visible { outline: 2px solid #67884e; outline-offset: 2px; }
}

.metricas-grafico-barras {
  display: flex;
  align-items: flex-end;
  gap: 0.35rem;
  height: 100%;
}

.metricas-barra {
  display: block;
  width: 1.25rem;
  border-radius: 6px 6px 0 0;
  transition: opacity 0.15s ease;

  &--cobrado { background-color: $metricas-verde; }
  &--pendiente { background-color: $metricas-barra-pendiente; }
  &--traslado { background-color: $metricas-barra-traslado; }

  @media (min-width: 576px) { width: 1.6rem; }
}

.metricas-grafico-columna.is-activa .metricas-barra { opacity: 0.9; }

// Solo durante la animación de entrada la altura tiene transición
.metricas-grafico.is-animando .metricas-barra {
  transition: height $metricas-duracion-barras cubic-bezier(0.22, 1, 0.36, 1), opacity 0.15s ease;
}

.metricas-grafico-etiquetas {
  display: flex;
  grid-column: 2;
  grid-row: 2;
  padding-top: 0.75rem;

  > span {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: $metricas-texto-secundario;
    white-space: nowrap;

    > small {
      font-size: 0.65rem;
      font-weight: 500;
      color: $metricas-texto-tenue;
    }

    &.is-activa,
    &.is-destacada {
      font-weight: 700;
      color: $metricas-verde-oscuro;
    }
  }
}

.metricas-tooltip {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 5;
  min-width: 13rem;
  padding: 0.65rem 0.85rem;
  color: #F2F0ED;
  background-color: #30312F;
  border-radius: 0.75rem;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  transform: translateX(-50%);
  pointer-events: none;

  &.is-izquierda { left: 0; transform: none; }
  &.is-derecha { left: auto; right: 0; transform: none; }
}

.metricas-tooltip-titulo {
  margin-bottom: 0.35rem;
  padding-bottom: 0.35rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: #FBF9F6;
  border-bottom: 1px solid rgba(115, 121, 111, 0.3);
}

.metricas-tooltip-fila {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;

  > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  i {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  &--cobrado {
    color: $metricas-verde-claro;
    i { background-color: #97B98C; }
  }

  &--pendiente {
    color: #FFDBCB;
    i { background-color: $metricas-barra-pendiente; }
  }

  &--traslado {
    color: #FFB691;
    i { background-color: $metricas-barra-traslado; }
  }
}

/* --- Tabla de desglose --- */
.btn.metricas-boton-csv {
  gap: 0.4rem;
  align-self: flex-start;
  border-radius: 0.75rem;

  @media (min-width: 992px) { align-self: auto; }
}

.metricas-tabla-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.metricas-tabla {
  width: 100%;
  min-width: 720px;
  border-collapse: collapse;
  font-size: 0.875rem;

  thead th {
    padding: 0.85rem 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: $metricas-texto-secundario;
    white-space: nowrap;
    background-color: $metricas-superficie;

    &:first-child { border-radius: 0.75rem 0 0 0.75rem; }
    &:last-child { border-radius: 0 0.75rem 0.75rem 0; }
  }

  tbody th,
  tbody td {
    padding: 1rem;
    white-space: nowrap;
    border-bottom: 1px solid $metricas-borde;
    font-variant-numeric: tabular-nums;
  }

  tbody th {
    font-weight: 600;
    color: $metricas-texto;
  }

  tbody tr {
    transition: background-color 0.15s ease;

    &:hover { background-color: #FBF9F6; }
    &:last-child th,
    &:last-child td { border-bottom: 0; }

    &.is-destacada {
      background-color: rgba(203, 236, 193, 0.22);

      th { color: $metricas-verde-oscuro; }
    }
  }
}

.metricas-celda-cobrado { font-weight: 600; color: $metricas-verde-oscuro; }
.metricas-celda-pendiente { font-weight: 600; color: $metricas-terracota; }
.metricas-celda-total { font-weight: 700; color: $metricas-texto; }

.metricas-punto {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: $metricas-verde-medio;
}

.metricas-etiqueta-curso {
  padding: 0.1rem 0.5rem;
  font-size: 0.65rem;
  font-weight: 700;
  color: #324D2E;
  background-color: $metricas-verde-claro;
  border-radius: 0.25rem;
}

.metricas-variacion {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8125rem;
  font-weight: 700;

  &.is-sube { color: $metricas-verde-medio; }
  &.is-baja { color: #BA1A1A; }
  &.is-neutra { color: $metricas-texto-tenue; font-weight: 600; }
}

@media (prefers-reduced-motion: reduce) {
  .metricas-grafico.is-animando .metricas-barra,
  .metricas-barra,
  .metricas-grafico-columna,
  .metricas-hero-progreso > span { transition: none; }
}

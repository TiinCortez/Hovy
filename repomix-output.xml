<file path="docs/migrations/005_presupuestos_estimados.sql">
-- Internal estimate for visits (slice 1).
--
-- Run once in the Supabase SQL Editor. Idempotent: safe to run again.
--
-- Design:
--   solicitud_servicio -> services a visit includes, with the VERIFIED surface
--                         (m2) per service. The estimate is computed as
--                         sum(usuario_servicio.precio_base x superficie_m2).
--   presupuestos.monto_estimado -> internal estimate stored next to the final
--                         price (monto_total) when the admin accepts it.
--
-- The estimate is INTERNAL ONLY: it must never be exposed to clients.

-- Column types: every PK in this schema is INTEGER (verified from
-- information_schema for presupuestos, detalle_presupuesto, solicitudes_visita),
-- so the FK columns below are INTEGER. servicios_catalogo.id_servicio is assumed
-- INTEGER too, because detalle_presupuesto.id_servicio is. If the foreign key
-- creation fails, check that type first.

CREATE TABLE IF NOT EXISTS public.solicitud_servicio (
  id_solicitud_servicio BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_solicitud          INTEGER NOT NULL
                        REFERENCES public.solicitudes_visita (id_solicitud) ON DELETE CASCADE,
  id_servicio           INTEGER NOT NULL
                        REFERENCES public.servicios_catalogo (id_servicio),
  superficie_m2         NUMERIC(12, 2) NOT NULL CHECK (superficie_m2 > 0),
  UNIQUE (id_solicitud, id_servicio)
);

CREATE INDEX IF NOT EXISTS solicitud_servicio_solicitud_idx
  ON public.solicitud_servicio (id_solicitud);

-- Internal estimate stored on the budget (nullable: old rows have none).
ALTER TABLE public.presupuestos
  ADD COLUMN IF NOT EXISTS monto_estimado NUMERIC(12, 2);
</file>

<file path="docs/migrations/006_mercadopago_oauth.sql">
-- Mercado Pago seller-account linking (OAuth).
--
-- Run once in the Supabase SQL Editor. Idempotent.
--
--   mercadopago_oauth_state -> one-time OAuth states (only the sha256 is stored).
--   mercadopago_conexion    -> one linked seller account per user, tokens
--                              encrypted by the server (AES-256-GCM).
-- Both tables are accessed only by the server with the service role key.

CREATE TABLE IF NOT EXISTS public.mercadopago_oauth_state (
  state_hash TEXT PRIMARY KEY,
  id_usuario BIGINT NOT NULL REFERENCES public.usuarios (id) ON DELETE CASCADE,
  expira_en  TIMESTAMPTZ NOT NULL,
  usado_en   TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS mercadopago_oauth_state_expira_idx
  ON public.mercadopago_oauth_state (expira_en);

CREATE TABLE IF NOT EXISTS public.mercadopago_conexion (
  id                BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_usuario        BIGINT NOT NULL UNIQUE REFERENCES public.usuarios (id) ON DELETE CASCADE,
  mp_user_id        BIGINT NOT NULL,
  access_token_enc  TEXT NOT NULL,
  refresh_token_enc TEXT NOT NULL,
  scope             TEXT,
  expira_en         TIMESTAMPTZ NOT NULL,
  estado            TEXT NOT NULL DEFAULT 'Conectada'
                    CHECK (estado IN ('Conectada', 'Reautorizar')),
  created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at        TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Defense in depth: the server uses the service role (bypasses RLS); enabling
-- RLS with no policies keeps these tables unreachable for anon/authenticated keys.
ALTER TABLE public.mercadopago_oauth_state ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.mercadopago_conexion ENABLE ROW LEVEL SECURITY;
</file>


      />

      <InmuebleModal
        isOpen={isInmuebleModalOpen}
        onClose={() => setIsInmuebleModalOpen(false)}
        inmuebleData={selectedInmueble}
        idCliente={cliente.id_cliente} 
        onSaved={handleInmuebleSaved}
      />
      
    </div>
  );
}
